---
/**
 * A1 — Rachat rétroactif du pilier 3a.
 *
 * Le calcul se fait dans le navigateur, en JavaScript natif : lacunes et
 * répartition par computePillar3aGaps, économie par computeTaxSavingOnDeduction
 * sur le total rachetable, retranché des deux revenus imposables. Les barèmes
 * arrivent par le fichier de données de l'année, chargé à la première
 * interaction (src/lib/display/tax-data.ts) ; l'année du rachat
 * est l'année fiscale des données, jamais l'horloge du visiteur.
 */
import CalculatorLayout from "../../layouts/CalculatorLayout.astro";
import CalculatorShell from "../../components/calculator/CalculatorShell.astro";
import GrossEstimator from "../../components/calculator/GrossEstimator.astro";
import {
	pillar3aBuyback,
	pillar3aBuybackIntro,
	pillar3aBuybackTaxYear,
	pillar3aBuybackTexts,
	pillar3aBuybackYear,
} from "../../calculators/pension/pillar-3a-buyback";
import { pillar3aBuybackPageData as pageData, pillar3aBuybackPagePart as pagePart } from "../../calculators/pension/pillar-3a-buyback-page-data";
import { pageDataJson } from "../../calculators/page-data";
import { exampleFormValues } from "../../calculators/field-values";
import { publishedCalculators } from "../../calculators/catalog";
import { getFederalData } from "../../data";
import { readPillar3aBuybackForm } from "../../lib/display/pillar-3a-buyback-form";
import { fr } from "../../i18n/fr";

const pillar3a = getFederalData(pillar3aBuybackYear).pillar3a;
const estimator = pageData.estimator;
// Cas exemple calculé au build par le moteur (docs/design-system.md § 4.2)
const initial = readPillar3aBuybackForm(exampleFormValues(pillar3aBuyback), pageData);
---

<CalculatorLayout definition={pillar3aBuyback}>
	<CalculatorShell
		definition={pillar3aBuyback}
		intro={pillar3aBuybackIntro}
		resultLabel={pillar3aBuybackTexts.resultLabel}
		resultNote={pillar3aBuybackTexts.disclaimer}
		guide={pillar3aBuybackTexts.guide}
		notice={
			pillar3aBuybackTaxYear.isFallback
				? fr.taxYearFallback.pillar3aBuyback(pillar3aBuybackTaxYear.year, pillar3aBuybackTaxYear.calendarYear)
				: undefined
		}
		verifiedOn={pillar3a.smallContributionCap.verifiedOn}
		catalog={publishedCalculators("pension")}
		grossPath={{ available: estimator !== null, year: pillar3aBuybackYear }}
		initial={initial}
		taxDataUrl={pagePart.taxDataUrl}
	>
		{estimator && <GrossEstimator slot="gross-path" lppUpperSalaryLimit={estimator.socialInsurance.occupationalPension.upperSalaryLimit.value} />}
	</CalculatorShell>

	<script type="application/json" id="pillar3a-data" set:html={pageDataJson(pagePart)} />
</CalculatorLayout>

<script>
	// Seul script au chargement : le résultat du cas exemple est rendu à la construction ;
	// le calcul se charge à la première interaction (CLAUDE.md § 3).
	import { onFirstInteraction } from "../../lib/display/first-interaction";
	onFirstInteraction(() => import("../../lib/display/pillar-3a-buyback-page"));
</script>
