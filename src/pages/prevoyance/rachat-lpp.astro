---
/**
 * A3 — Rachat LPP : économie d'impôt et échelonnement.
 *
 * Le calcul se fait dans le navigateur, en JavaScript natif : refus motivés
 * (art. 79b al. 1 et 3 LPP), puis économie du rachat en une fois et de chaque
 * tranche par computeTaxSavingOnDeduction, retranchée des deux revenus
 * imposables, et classement des tranches face au délai de blocage. Les barèmes
 * arrivent par le fichier de données de l'année, chargé à la première
 * interaction (src/lib/display/tax-data.ts), le délai par le JSON de la page ; l'année
 * est l'année fiscale des données, jamais l'horloge du visiteur.
 */
import CalculatorLayout from "../../layouts/CalculatorLayout.astro";
import CalculatorShell from "../../components/calculator/CalculatorShell.astro";
import GrossEstimator from "../../components/calculator/GrossEstimator.astro";
import ResultTable from "../../components/ui/ResultTable.astro";
import {
	lppBuyback,
	lppBuybackIntro,
	lppBuybackTaxYear,
	lppBuybackTexts,
	lppBuybackVerifiedOn,
	lppBuybackYear,
} from "../../calculators/pension/lpp-buyback";
import { lppBuybackPageData as pageData, lppBuybackPagePart as pagePart } from "../../calculators/pension/lpp-buyback-page-data";
import { pageDataJson } from "../../calculators/page-data";
import { exampleFormValues } from "../../calculators/field-values";
import { publishedCalculators } from "../../calculators/catalog";
import { readLppBuybackForm } from "../../lib/display/lpp-buyback-form";
import { fr } from "../../i18n/fr";

const texts = lppBuybackTexts;
const estimator = pageData.estimator;
// Cas exemple calculé au build par le moteur (docs/design-system.md § 4.2)
const initial = readLppBuybackForm(exampleFormValues(lppBuyback), pageData);
const shown = initial.shown;
// Colonnes « retrait prévu » : seulement si une année de retrait classe les tranches
const withLock = Boolean(shown?.calendar.some((entry) => entry.status !== null));
const scenarioRows = (shown?.scenarios ?? []).map((scenario) =>
	[scenario.label, scenario.tranches, scenario.total, scenario.difference, ...(withLock ? [scenario.lock ?? ""] : [])],
);
const calendarRows = (shown?.calendar ?? []).map((entry) => [entry.buybackYear, entry.lockEnds, entry.compatibleFrom, ...(withLock ? [entry.status ?? ""] : [])]);
---

<CalculatorLayout definition={lppBuyback}>
	<CalculatorShell
		definition={lppBuyback}
		intro={lppBuybackIntro}
		resultLabel={texts.resultLabel}
		resultNote={texts.disclaimer}
		notice={
			lppBuybackTaxYear.isFallback
				? fr.taxYearFallback.lppBuyback(lppBuybackTaxYear.year, lppBuybackTaxYear.calendarYear)
				: undefined
		}
		verifiedOn={lppBuybackVerifiedOn}
		catalog={publishedCalculators("pension")}
		grossPath={{ available: estimator !== null, year: lppBuybackYear }}
		initial={initial}
		taxDataUrl={pagePart.taxDataUrl}
		vigilanceId="lpp-buyback-warnings"
	>
		{estimator && <GrossEstimator slot="gross-path" lppUpperSalaryLimit={estimator.socialInsurance.occupationalPension.upperSalaryLimit.value} />}
		<div slot="result" class="mt-md flex flex-col gap-xl">
			<div id="lpp-buyback-result" class="flex max-w-reading flex-col gap-md" hidden={shown === null}>
				<p id="lpp-buyback-not-deducted" class="text-label font-bold" hidden={!shown?.notDeducted}>{shown?.notDeducted}</p>

				<ResultTable
					id="lpp-buyback-scenarios"
					heading={texts.scenarios.heading}
					caption={texts.scenarios.caption}
					rows={scenarioRows}
					withOptional={withLock}
					columns={[
						{ label: texts.scenarios.columns.scenario },
						{ label: texts.scenarios.columns.tranches },
						{ label: texts.scenarios.columns.total, align: "right" },
						{ label: texts.scenarios.columns.difference, align: "right" },
						{ label: texts.scenarios.columns.lock, optional: true },
					]}
				/>

				<ResultTable
					id="lpp-buyback-calendar"
					heading={texts.calendar.heading}
					caption={texts.calendar.caption}
					rows={calendarRows}
					withOptional={withLock}
					columns={[
						{ label: texts.calendar.columns.buybackYear },
						{ label: texts.calendar.columns.lockEnds },
						{ label: texts.calendar.columns.compatibleFrom },
						{ label: texts.calendar.columns.status, optional: true },
					]}
				>
					<p class="text-fine text-ink-muted">{texts.calendar.classesIntro}</p>
					<ul class="flex list-disc flex-col gap-xs pl-lg text-fine text-ink-muted">
						{texts.calendar.classes.map((entry) => <li>{entry}</li>)}
					</ul>
				</ResultTable>
			</div>

		</div>
	</CalculatorShell>

	<script type="application/json" id="lpp-buyback-data" set:html={pageDataJson(pagePart)} />
</CalculatorLayout>

<script>
	// Seul script au chargement : le résultat du cas exemple est rendu à la construction ;
	// le calcul se charge à la première interaction (CLAUDE.md § 3).
	import { onFirstInteraction } from "../../lib/display/first-interaction";
	onFirstInteraction(() => import("../../lib/display/lpp-buyback-page"));
</script>
