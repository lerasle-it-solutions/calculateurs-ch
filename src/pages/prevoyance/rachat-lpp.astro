---
/**
 * A3 — Rachat LPP : économie d'impôt et échelonnement.
 *
 * Le calcul se fait dans le navigateur, en JavaScript natif : refus motivés
 * (art. 79b al. 1 et 3 LPP), puis économie du rachat en une fois et de chaque
 * tranche par computeTaxSavingOnDeduction, retranchée des deux revenus
 * imposables, et classement des tranches face au délai de blocage. Les barèmes
 * et le délai arrivent par un paquet JSON construit à la compilation ; l'année
 * est l'année fiscale des données, jamais l'horloge du visiteur.
 */
import CalculatorLayout from "../../layouts/CalculatorLayout.astro";
import CalculatorShell from "../../components/calculator/CalculatorShell.astro";
import TraceLabels from "../../components/calculator/TraceLabels.astro";
import GrossEstimator from "../../components/calculator/GrossEstimator.astro";
import {
	lppBuyback,
	lppBuybackIntro,
	lppBuybackLockPeriod,
	lppBuybackTaxYear,
	lppBuybackTexts,
	lppBuybackVerifiedOn,
	lppBuybackYear,
} from "../../calculators/pension/lpp-buyback";
import { publishedCalculators } from "../../calculators/catalog";
import { ROMANDE_CANTONS } from "../../calculators/cantons";
import { getCantonData, getMunicipalMultipliers } from "../../data";
import { getTaxScalesBundle } from "../../data/tax-scales";
import { getGrossToTaxableRuleSet } from "../../data/gross-to-taxable";
import { fr } from "../../i18n/fr";

const texts = lppBuybackTexts;
const cantons = lppBuyback.scope.cantonsCovered as (typeof ROMANDE_CANTONS)[number]["code"][];

const bundle = getTaxScalesBundle(lppBuybackYear, cantons);

// Mode « salaire brut » : seulement si l'estimateur a ses données pour l'année de calcul
const estimator = (() => {
	try {
		return getGrossToTaxableRuleSet(lppBuybackYear, cantons);
	} catch {
		return null;
	}
})();

const pageData = {
	taxYear: lppBuybackYear,
	lockPeriodYears: { value: lppBuybackLockPeriod.value, sourceId: lppBuybackLockPeriod.sourceId },
	bundle,
	estimator,
	municipalities: Object.fromEntries(
		(getMunicipalMultipliers()?.multipliers ?? [])
			.filter((entry) => cantons.includes(entry.canton))
			.map((entry) => [`${entry.municipality} (${entry.canton})`, { ofsId: entry.bfsId, canton: entry.canton }]),
	),
	// Calculette officielle du canton, lue dans coverage.officialCalculator des données
	officialCalculators: Object.fromEntries(
		cantons.flatMap((code) => {
			const official = getCantonData(code).coverage?.officialCalculator;
			return official && "url" in official ? [[code, official]] : [];
		}),
	),
	texts: {
		outOfScope: Object.fromEntries(ROMANDE_CANTONS.map((canton) => [canton.code, texts.outOfScope(canton.name)])),
		// Seules les communes non couvertes en entier en ont besoin (PartialCoverageError.municipality)
		outOfScopeMunicipality: Object.fromEntries(
			bundle.municipalities.flatMap(({ coverage }) =>
				coverage?.municipality === undefined ? [] : [[coverage.municipality, texts.outOfScopeMunicipality(coverage.municipality)]],
			),
		),
		missingData: texts.missingData,
		municipalityMismatch: texts.municipalityMismatch,
		unknownMunicipality: texts.unknownMunicipality,
		outOfScopeShort: texts.outOfScopeShort,
		missingDataShort: texts.missingDataShort,
		inputShort: texts.inputShort,
		refusedShort: texts.refusedShort,
		notDeducted: texts.notDeducted,
		single: texts.scenarios.single,
		spread: texts.scenarios.spread,
		estimateNote: fr.grossEstimator.resultNote,
	},
};
// Données en JSON dans la page, sans « < » qui fermerait la balise
const pageDataJson = JSON.stringify(pageData).replace(/</g, "\\u003c");

const tableClass = "w-full border-collapse text-label";
const captionClass = "px-md py-sm text-left text-fine text-ink-muted";
const headClass = "bg-tint px-md py-sm text-left font-bold";
const cellClass = "border-b border-hairline px-md py-sm";
---

<CalculatorLayout definition={lppBuyback}>
	<CalculatorShell
		definition={lppBuyback}
		intro={lppBuybackIntro}
		resultLabel={texts.resultLabel}
		resultNote={texts.disclaimer}
		notice={
			lppBuybackTaxYear.isFallback
				? fr.taxYearFallback.lppBuyback(lppBuybackTaxYear.year, lppBuybackTaxYear.calendarYear)
				: undefined
		}
		verifiedOn={lppBuybackVerifiedOn}
		catalog={publishedCalculators("pension")}
		formExtraAfter="federalTaxableIncome"
	>
		{estimator && <GrossEstimator slot="form-extra" lppUpperSalaryLimit={estimator.socialInsurance.occupationalPension.upperSalaryLimit.value} />}
		<div slot="result" class="mt-md flex flex-col gap-xl">
			<div id="lpp-buyback-result" class="flex max-w-reading flex-col gap-md" hidden>
				<dl class="flex flex-col text-label">
					{
						Object.entries(texts.summary).map(([key, label]) => (
							<div class="flex justify-between gap-md border-b border-hairline py-sm">
								<dt>{label}</dt>
								<dd data-summary={key} class="text-right font-bold tabular-nums" />
							</div>
						))
					}
				</dl>
				<p id="lpp-buyback-not-deducted" class="text-label font-bold" hidden></p>

				<section class="flex flex-col gap-sm">
					<h3 class="text-subheading">{texts.scenarios.heading}</h3>
					<div class="overflow-x-auto rounded-panel border border-hairline">
						<table class={tableClass}>
							<caption class={captionClass}>{texts.scenarios.caption}</caption>
							<thead>
								<tr>
									<th scope="col" class={headClass}>{texts.scenarios.columns.scenario}</th>
									<th scope="col" class={headClass}>{texts.scenarios.columns.tranches}</th>
									<th scope="col" class={`${headClass} text-right`}>{texts.scenarios.columns.total}</th>
									<th scope="col" class={`${headClass} text-right`}>{texts.scenarios.columns.difference}</th>
									<th scope="col" class={headClass} data-lock-column hidden>{texts.scenarios.columns.lock}</th>
								</tr>
							</thead>
							<tbody id="lpp-buyback-scenarios" data-cell-class={cellClass}></tbody>
						</table>
					</div>
				</section>

				<section class="flex flex-col gap-sm">
					<h3 class="text-subheading">{texts.calendar.heading}</h3>
					<div class="overflow-x-auto rounded-panel border border-hairline">
						<table class={tableClass}>
							<caption class={captionClass}>{texts.calendar.caption}</caption>
							<thead>
								<tr>
									<th scope="col" class={headClass}>{texts.calendar.columns.buybackYear}</th>
									<th scope="col" class={headClass}>{texts.calendar.columns.lockEnds}</th>
									<th scope="col" class={headClass}>{texts.calendar.columns.compatibleFrom}</th>
									<th scope="col" class={headClass} data-lock-column hidden>{texts.calendar.columns.status}</th>
								</tr>
							</thead>
							<tbody id="lpp-buyback-calendar" data-cell-class={cellClass}></tbody>
						</table>
					</div>
					<p class="text-fine text-ink-muted">{texts.calendar.classesIntro}</p>
					<ul class="flex list-disc flex-col gap-xs pl-lg text-fine text-ink-muted">
						{texts.calendar.classes.map((entry) => <li>{entry}</li>)}
					</ul>
				</section>
			</div>

			<aside class="flex max-w-reading flex-col gap-md rounded-panel bg-tint p-lg text-label" aria-labelledby="lpp-buyback-warnings">
				<h3 id="lpp-buyback-warnings" class="text-subheading">{texts.warningsHeading}</h3>
				{
					texts.warnings.map((warning) => (
						<div class="flex flex-col gap-xs">
							<p>
								<strong class="font-bold">{warning.title}</strong> {warning.text}
							</p>
							{warning.items.length > 0 && (
								<ul class="flex list-disc flex-col gap-xs pl-lg">
									{warning.items.map((item) => <li>{item}</li>)}
								</ul>
							)}
						</div>
					))
				}
			</aside>
		</div>
	</CalculatorShell>

	<script type="application/json" id="lpp-buyback-data" set:html={pageDataJson} />
	<TraceLabels modules={estimator ? ["lpp-buyback", "gross-to-taxable"] : ["lpp-buyback"]} />
</CalculatorLayout>

<script>
	import { taxScalesFromBundle, type TaxScalesBundle } from "../../lib/calculations/tax-scales-bundle";
	import type { TaxInput } from "../../lib/calculations/tax";
	import type { BreakdownRow, StatusLink } from "../../lib/display/pillar-3a-buyback";
	import { displayLppBuyback, type LppBuybackDisplay, type LppBuybackDisplayTexts } from "../../lib/display/lpp-buyback";
	import { coverageStatusOf } from "../../lib/display/coverage";
	import type { ResultStatus } from "../../lib/display/result-card";
	import type { GrossToTaxableRuleSet } from "../../lib/calculations/gross-to-taxable";
	import type { EstimatorReading, Household } from "../../lib/display/gross-estimator-ui";

	type PageData = {
		taxYear: number;
		lockPeriodYears: { value: number; sourceId: string };
		bundle: TaxScalesBundle;
		municipalities: Record<string, { ofsId: number; canton: TaxInput["canton"] }>;
		officialCalculators: Record<string, StatusLink>;
		texts: LppBuybackDisplayTexts & { municipalityMismatch: string; unknownMunicipality: string; inputShort: string; estimateNote: string };
		estimator: GrossToTaxableRuleSet | null;
	};

	const dataElement = document.getElementById("lpp-buyback-data");
	const form = document.querySelector<HTMLFormElement>("[data-calculator]");
	const resultBlock = document.getElementById("lpp-buyback-result");
	const notDeducted = document.getElementById("lpp-buyback-not-deducted");
	const scenarioBody = document.getElementById("lpp-buyback-scenarios");
	const calendarBody = document.getElementById("lpp-buyback-calendar");

	if (dataElement && form && resultBlock && notDeducted && scenarioBody && calendarBody) {
		const data = JSON.parse(dataElement.textContent ?? "{}") as PageData;
		const cellClass = scenarioBody.dataset.cellClass ?? "";

		/** Remplit un corps de tableau : une ligne par entrée, une cellule par colonne ; `right` aligne les montants. */
		const fill = (body: HTMLElement, rows: (string | null)[][], right: number[]) => {
			body.replaceChildren(
				...rows.map((cells) => {
					const tr = document.createElement("tr");
					cells.forEach((text, index) => {
						if (text === null) return;
						const td = document.createElement(index === 0 ? "th" : "td");
						if (index === 0) td.setAttribute("scope", "row");
						td.className = `${cellClass}${index === 0 ? " text-left font-medium" : ""}${right.includes(index) ? " text-right tabular-nums" : ""}`;
						td.textContent = text;
						tr.append(td);
					});
					return tr;
				}),
			);
		};

		const publish = (value: string, breakdown: BreakdownRow[], status: ResultStatus | null, shown: LppBuybackDisplay | null, note: string | null = null) => {
			resultBlock.hidden = shown === null;
			if (shown?.summary) {
				for (const slot of resultBlock.querySelectorAll<HTMLElement>("[data-summary]")) {
					slot.textContent = shown.summary[slot.dataset.summary as keyof typeof shown.summary];
				}
			}
			notDeducted.hidden = !shown?.notDeducted;
			notDeducted.textContent = shown?.notDeducted ?? "";
			const withLock = Boolean(shown?.calendar.some((entry) => entry.status !== null));
			for (const column of resultBlock.querySelectorAll<HTMLElement>("[data-lock-column]")) column.hidden = !withLock;
			fill(
				scenarioBody,
				(shown?.scenarios ?? []).map((scenario) => [scenario.label, scenario.tranches, scenario.total, scenario.difference, withLock ? scenario.lock : null]),
				[2, 3],
			);
			fill(
				calendarBody,
				(shown?.calendar ?? []).map((entry) => [entry.buybackYear, entry.lockEnds, entry.compatibleFrom, withLock ? entry.status : null]),
				[],
			);
			document.dispatchEvent(new CustomEvent("calc:update", { detail: { value, breakdown, status, note } }));
		};

		// Mode « salaire brut » : l'estimateur se charge à la demande, à la première ouverture du bloc
		const estimatorBox = form.querySelector<HTMLDetailsElement>("[data-estimator]");
		let estimator: ((household: Household) => EstimatorReading) | undefined;
		const inputStatus = (text: string): ResultStatus => ({ text, short: data.texts.inputShort });
		const amountOf = (text: string | undefined): number | null => (text === undefined || text === "" ? null : Number(text));

		const update = () => {
			const fields = Object.fromEntries(new FormData(form)) as Record<string, string>;
			const municipality = data.municipalities[fields.municipality ?? ""];
			const children = Number(fields.children || 0);
			const childrenAges = (fields.childrenAges ?? "")
				.split(",")
				.map((age) => Number(age.trim()))
				.filter((age) => age !== 0 && Number.isFinite(age));

			if (!municipality) {
				return publish("—", [], fields.municipality ? inputStatus(data.texts.unknownMunicipality) : null, null);
			}
			if (municipality.canton !== fields.canton) return publish("—", [], inputStatus(data.texts.municipalityMismatch), null);

			// Couverture établie dès le canton, la commune, l'état civil et les enfants (P5)
			const scales = taxScalesFromBundle(data.bundle, municipality.ofsId);
			const maritalStatus = fields.maritalStatus === "married" ? "married" : "single";
			if (Number.isFinite(children) && children >= 0) {
				const coverage = coverageStatusOf({ canton: municipality.canton, maritalStatus, children }, scales, data.texts, data.officialCalculators);
				if (coverage) return publish("—", [], coverage, null);
			}
			// Revenus imposables estimés depuis le salaire brut : avant rachat, non diminués
			const estimate = estimatorBox?.open && estimator ? estimator({ canton: municipality.canton, married: maritalStatus === "married", children, childrenAges }) : null;
			if (estimate && "status" in estimate) return publish("—", [], inputStatus(estimate.status), null);
			if (estimatorBox?.open && !estimate) return publish("—", [], null, null);
			const cantonalTaxableIncome = estimate ? estimate.cantonalTaxableIncome : amountOf(fields.cantonalTaxableIncome);
			const federalTaxableIncome = estimate ? estimate.federalTaxableIncome : amountOf(fields.federalTaxableIncome);
			const potential = amountOf(fields.buybackPotential);
			const amount = amountOf(fields.buybackAmount);
			const withdrawalYear = amountOf(fields.plannedCapitalWithdrawalYear);
			const amounts = [cantonalTaxableIncome, federalTaxableIncome, potential, amount, children];
			if (amounts.some((value) => value === null || !Number.isFinite(value) || value < 0)) return publish("—", [], null, null);
			if (withdrawalYear !== null && !Number.isInteger(withdrawalYear)) return publish("—", [], null, null);

			const taxInput: TaxInput = {
				taxYear: data.taxYear,
				canton: municipality.canton,
				municipalityOfsId: municipality.ofsId,
				maritalStatus,
				children,
				childrenAges,
				denomination: "none",
				federalTaxableIncome: federalTaxableIncome!,
				cantonalTaxableIncome: cantonalTaxableIncome!,
				taxableWealth: 0,
			};
			const shown = displayLppBuyback(
				{
					taxInput,
					scales,
					buybackPotential: Math.round(potential!),
					amount: Math.round(amount!),
					unrepaidHomeOwnershipWithdrawal: fields.unrepaidHomeOwnershipWithdrawal === "yes",
					plannedCapitalWithdrawalYear: withdrawalYear,
					lockPeriodYears: data.lockPeriodYears,
				},
				data.texts,
				data.officialCalculators,
			);
			const computed = shown.status === null;
			publish(
				shown.value,
				estimate && computed ? [...estimate.rows, ...shown.breakdown] : shown.breakdown,
				shown.status,
				computed ? shown : null,
				estimate && computed ? data.texts.estimateNote : null,
			);
		};

		estimatorBox?.addEventListener("toggle", async () => {
			if (estimatorBox.open && !estimator && data.estimator) {
				estimator = (await import("../../lib/display/gross-estimator-ui")).attachEstimator(form, data.estimator, null);
			}
			update();
		});
		form.addEventListener("input", update);
		form.addEventListener("change", update);
		requestAnimationFrame(update);
	}
</script>
