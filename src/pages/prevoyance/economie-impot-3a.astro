---
/**
 * A2 — Économie d'impôt d'un versement 3a.
 *
 * Le calcul se fait dans le navigateur, en JavaScript natif : plafond et
 * montant déductible de chaque personne, puis économie par
 * computeTaxSavingOnDeduction sur la somme des déductions, retranchée des deux
 * revenus imposables. Les barèmes arrivent par le fichier de données de l'année,
 * chargé à la première interaction (src/lib/display/tax-data.ts) ; l'année est
 * l'année fiscale des données, jamais l'horloge du visiteur.
 */
import CalculatorLayout from "../../layouts/CalculatorLayout.astro";
import CalculatorShell from "../../components/calculator/CalculatorShell.astro";
import GrossEstimator from "../../components/calculator/GrossEstimator.astro";
import {
	pillar3aTaxSaving,
	pillar3aTaxSavingIntro,
	pillar3aTaxSavingTaxYear,
	pillar3aTaxSavingTexts,
	pillar3aTaxSavingYear,
} from "../../calculators/pension/pillar-3a-tax-saving";
import { pillar3aTaxSavingPageData as pageData, pillar3aTaxSavingPagePart as pagePart } from "../../calculators/pension/pillar-3a-tax-saving-page-data";
import { pageDataJson } from "../../calculators/page-data";
import { exampleFormValues } from "../../calculators/field-values";
import { publishedCalculators } from "../../calculators/catalog";
import { getFederalData } from "../../data";
import { readPillar3aTaxSavingForm } from "../../lib/display/pillar-3a-tax-saving-form";
import { fr } from "../../i18n/fr";

const texts = pillar3aTaxSavingTexts;
const pillar3a = getFederalData(pillar3aTaxSavingYear).pillar3a;
const estimator = pageData.estimator;
// Cas exemple calculé au build par le moteur (docs/design-system.md § 4.2)
const initial = readPillar3aTaxSavingForm(exampleFormValues(pillar3aTaxSaving), pageData);
const summary = initial.shown;
---

<CalculatorLayout definition={pillar3aTaxSaving}>
	<CalculatorShell
		definition={pillar3aTaxSaving}
		intro={pillar3aTaxSavingIntro}
		resultLabel={texts.resultLabel}
		resultNote={texts.disclaimer}
		guide={texts.guide}
		notice={
			pillar3aTaxSavingTaxYear.isFallback
				? fr.taxYearFallback.pillar3aTaxSaving(pillar3aTaxSavingTaxYear.year, pillar3aTaxSavingTaxYear.calendarYear)
				: undefined
		}
		verifiedOn={pillar3a.smallContributionCap.verifiedOn}
		catalog={publishedCalculators("pension")}
		grossPath={{ available: estimator !== null, year: pillar3aTaxSavingYear }}
		initial={initial}
		taxDataUrl={pagePart.taxDataUrl}
	>
		{estimator && <GrossEstimator slot="gross-path" lppUpperSalaryLimit={estimator.socialInsurance.occupationalPension.upperSalaryLimit.value} />}
		<div slot="result" class="mt-md flex max-w-reading flex-col gap-md">
			{/* Excédent non déductible, à rembourser : avertissement renforcé (§ 2.6, arbitrage du 17.10.2026) */}
			<p
				id="pillar3a-saving-excess"
				hidden={!summary?.excess}
				class="rounded-r-panel border-l-4 border-warning-signal bg-warning-tint p-lg text-label text-ink"
			>
				<strong class="font-bold text-warning">{fr.calculator.warningPrefix}</strong>{" "}<span data-excess-text>{summary?.excess ? texts.excessWarning.replace("{amount}", summary.excess) : ""}</span>
			</p>
		</div>
	</CalculatorShell>

	<script type="application/json" id="pillar3a-saving-data" set:html={pageDataJson(pagePart)} />
</CalculatorLayout>

<script>
	// Seul script au chargement : le résultat du cas exemple est rendu à la construction ;
	// le calcul se charge à la première interaction (CLAUDE.md § 3).
	import { onFirstInteraction } from "../../lib/display/first-interaction";
	onFirstInteraction(() => import("../../lib/display/pillar-3a-tax-saving-page"));
</script>
