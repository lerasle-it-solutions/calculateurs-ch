---
import BaseLayout from "../layouts/BaseLayout.astro";
import { fr } from "../i18n/fr";
import { sourceFreshnessReport } from "../lib/data-report";
import { getMunicipalMultipliers } from "../data";

const rows = sourceFreshnessReport();
const overdueCount = rows.filter((row) => row.overdueCount > 0).length;

const multipliers = getMunicipalMultipliers();

const dateFormat = new Intl.DateTimeFormat("fr-CH", {
	day: "2-digit",
	month: "2-digit",
	year: "numeric",
});
const numberFormat = new Intl.NumberFormat("fr-CH");

const formatDate = (isoDate: string): string =>
	dateFormat.format(new Date(`${isoDate}T00:00:00Z`));
---

<BaseLayout
	title={`${fr.dataPage.title} — ${fr.site.name}`}
	description={fr.dataPage.lead}
	wide={true}
>
	<div class="flex flex-col gap-2xl">
		<header class="flex max-w-reading flex-col gap-md">
			<h1 class="text-title">{fr.dataPage.title}</h1>
			<p class="text-body">{fr.dataPage.lead}</p>
			{
				rows.length > 0 && (
					<p class="font-serif text-fine">
						{fr.dataPage.summary(rows.length, overdueCount)}
					</p>
				)
			}
		</header>

		{
			rows.length === 0 ? (
				<p class="max-w-reading text-body">{fr.dataPage.empty}</p>
			) : (
				<div class="overflow-x-auto border border-rule">
					<table class="w-full border-collapse text-body">
						<thead>
							<tr class="border-b border-rule bg-tint text-label">
								<th scope="col" class="px-lg py-sm text-left font-normal">
									{fr.dataPage.columnSource}
								</th>
								<th scope="col" class="px-lg py-sm text-left font-normal">
									{fr.dataPage.columnAuthority}
								</th>
								<th scope="col" class="px-lg py-sm text-left font-normal">
									{fr.dataPage.columnCadence}
								</th>
								<th scope="col" class="px-lg py-sm text-right font-normal">
									{fr.dataPage.columnTracked}
								</th>
								<th scope="col" class="px-lg py-sm text-left font-normal">
									{fr.dataPage.columnVerifiedOn}
								</th>
								<th scope="col" class="px-lg py-sm text-left font-normal">
									{fr.dataPage.columnDueOn}
								</th>
							</tr>
						</thead>
						<tbody>
							{rows.map((row) => (
								<tr class="border-t border-rule align-top">
									<td class="px-lg py-md">
										{row.source ? (
											<a href={row.source.url} class="font-serif">
												{row.source.name}
											</a>
										) : (
											<span class="font-serif text-fine">
												{row.sourceId} — {fr.dataPage.sourceUnknown}
											</span>
										)}
									</td>
									<td class="px-lg py-md font-serif text-fine">
										{row.source?.authority ?? fr.dataPage.sourceUnknown}
									</td>
									<td class="px-lg py-md text-fine">
										{row.source ? fr.dataPage.cadence[row.source.cadence] : "—"}
									</td>
									<td class="px-lg py-md text-right tabular-nums">
										{numberFormat.format(row.trackedValues)}
									</td>
									<td class="px-lg py-md tabular-nums">
										<time datetime={row.oldestVerifiedOn}>
											{formatDate(row.oldestVerifiedOn)}
										</time>
									</td>
									<td class="px-lg py-md tabular-nums">
										<time datetime={row.nextDueOn}>
											{formatDate(row.nextDueOn)}
										</time>
										{row.overdueCount > 0 && (
											<span class="block font-serif text-fine text-warning">
												{fr.dataPage.overdue} ({row.overdueCount})
											</span>
										)}
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			)
		}

		{
			multipliers && multipliers.multipliers.length > 0 && (
				<section class="flex max-w-reading flex-col gap-sm border-t border-rule pt-lg">
					<h2 class="text-heading">{fr.dataPage.municipalCsv.heading}</h2>
					<p class="text-body">
						{fr.dataPage.municipalCsv.intro(multipliers.multipliers.length)}
					</p>
					<p>
						<a href="/donnees/coefficients-communaux.csv">
							{fr.dataPage.municipalCsv.downloadLabel}
						</a>
					</p>
					<p class="font-serif text-fine">{fr.dataPage.municipalCsv.unitCaveat}</p>
				</section>
			)
		}
	</div>
</BaseLayout>
