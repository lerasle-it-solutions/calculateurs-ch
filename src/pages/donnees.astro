---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import Button from "../components/ui/Button.astro";
import { fr } from "../i18n/fr";
import { formatSwissNumber } from "../lib/format/chf";
import { collectionToolsReport, sourceFreshnessReport } from "../lib/data-report";
import { attributionTextsFor } from "../lib/attribution";
import { getMunicipalMultipliers } from "../data";

const rows = sourceFreshnessReport();
const collectionTools = collectionToolsReport();
const overdueCount = rows.filter(
	(row) => row.overdueCount > 0 || row.neverVerifiedCount > 0,
).length;

const multipliers = getMunicipalMultipliers();

const dateFormat = new Intl.DateTimeFormat("fr-CH", {
	day: "2-digit",
	month: "2-digit",
	year: "numeric",
});

const formatDate = (isoDate: string): string =>
	dateFormat.format(new Date(`${isoDate}T00:00:00Z`));
---

<BaseLayout
	title={`${fr.dataPage.title} — ${fr.site.name}`}
	description={fr.dataPage.metaDescription}
>
	<Section hero={true}>
		<h1 class="max-w-reading text-title">{fr.dataPage.title}</h1>
		<p class="mt-sm max-w-reading text-lead text-ink-muted">{fr.dataPage.lead}</p>
		{
			rows.length > 0 && (
				<p class="mt-2xl max-w-reading border-l-2 border-hairline pl-md text-fine text-ink-muted">
					{fr.dataPage.summary(rows.length, overdueCount)}
				</p>
			)
		}
	</Section>

	<Section tone="tint">

		{
			rows.length === 0 ? (
				<p class="max-w-reading text-body">{fr.dataPage.empty}</p>
			) : (
				<div class="overflow-x-auto rounded-panel border border-hairline bg-paper">
					<table class="w-full border-collapse text-label">
						<caption class="caption-top px-md py-sm text-left text-fine text-ink-muted">
							{fr.dataPage.title}
						</caption>
						<thead>
							<tr class="bg-tint text-left font-bold">
								<th scope="col" class="border-b border-hairline px-md py-sm">
									{fr.dataPage.columnSource}
								</th>
								<th scope="col" class="border-b border-hairline px-md py-sm">
									{fr.dataPage.columnAuthority}
								</th>
								<th scope="col" class="border-b border-hairline px-md py-sm">
									{fr.dataPage.columnCadence}
								</th>
								<th scope="col" class="border-b border-hairline px-md py-sm text-right">
									{fr.dataPage.columnTracked}
								</th>
								<th scope="col" class="border-b border-hairline px-md py-sm">
									{fr.dataPage.columnVerifiedOn}
								</th>
								<th scope="col" class="border-b border-hairline px-md py-sm">
									{fr.dataPage.columnDueOn}
								</th>
							</tr>
						</thead>
						<tbody>
							{rows.map((row) => (
								<tr class="align-top">
									<td class="border-b border-hairline px-md py-sm">
										{row.source?.url ? (
											<a href={row.source.url}>{row.source.name}</a>
										) : row.source ? (
											<span>{row.source.name}</span>
										) : (
											<span class="text-fine text-ink-muted">
												{row.sourceId} — {fr.dataPage.sourceUnknown}
											</span>
										)}
										{row.source &&
											attributionTextsFor([row.sourceId]).map((text) => (
												<p class="mt-xs text-fine text-ink-muted">{text}</p>
											))}
									</td>
									<td class="border-b border-hairline px-md py-sm text-fine">
										{row.source?.authority ?? fr.dataPage.sourceUnknown}
									</td>
									<td class="border-b border-hairline px-md py-sm text-fine">
										{row.source ? fr.dataPage.cadence[row.source.cadence] : "—"}
									</td>
									<td class="border-b border-hairline px-md py-sm text-right tabular-nums">
										{formatSwissNumber(row.trackedValues)}
									</td>
									<td class="border-b border-hairline px-md py-sm tabular-nums">
										{row.oldestVerifiedOn === null ? (
											<span class="text-warning">{fr.dataPage.neverVerified}</span>
										) : (
											<time datetime={row.oldestVerifiedOn}>
												{formatDate(row.oldestVerifiedOn)}
											</time>
										)}
									</td>
									<td class="border-b border-hairline px-md py-sm tabular-nums">
										{row.nextDueOn === null ? (
											fr.common.emptyValue
										) : (
											<time datetime={row.nextDueOn}>
												{formatDate(row.nextDueOn)}
											</time>
										)}
										{row.overdueCount > 0 && (
											<span class="block text-fine font-bold text-warning">
												{fr.dataPage.overdue} ({row.overdueCount})
											</span>
										)}
									</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			)
		}
	</Section>

		{
			collectionTools.length > 0 && (
				<Section tone="paper" class="flex flex-col gap-lg">
					<h2 class="text-heading">{fr.dataPage.collectionTools.heading}</h2>
					<p class="max-w-reading text-body">{fr.dataPage.collectionTools.intro}</p>
					<ul class="flex flex-col gap-md">
						{collectionTools.map((tool) => (
							<li class="flex flex-col gap-2xs">
								{tool.source?.url ? (
									<a href={tool.source.url}>{tool.source.name}</a>
								) : (
									<span>
										{tool.source?.name ?? `${tool.sourceId} — ${fr.dataPage.sourceUnknown}`}
									</span>
								)}
								<span class="text-fine text-ink-muted">
									{tool.source?.authority ?? fr.dataPage.sourceUnknown} ·{" "}
									<span class="tabular-nums">
										{fr.dataPage.collectionTools.collectedValues(tool.collectedValues)}
									</span>
								</span>
								{tool.source &&
									attributionTextsFor([tool.sourceId]).map((text) => (
										<p class="border-l-2 border-hairline pl-md text-fine text-ink-muted">{text}</p>
									))}
							</li>
						))}
					</ul>
				</Section>
			)
		}

		{
			multipliers && multipliers.multipliers.length > 0 && (
				<Section tone="tint" class="flex flex-col gap-lg">
					<h2 class="text-heading">{fr.dataPage.municipalCsv.heading}</h2>
					<p class="max-w-reading text-body">
						{fr.dataPage.municipalCsv.intro(multipliers.multipliers.length)}
					</p>
					<p>
						<Button href="/donnees/coefficients-communaux.csv" variant="secondary">
							{fr.dataPage.municipalCsv.downloadLabel}
						</Button>
					</p>
					<p class="max-w-reading border-l-2 border-hairline pl-md text-fine text-ink-muted">
						{fr.dataPage.municipalCsv.unitCaveat}
					</p>
				</Section>
			)
		}
</BaseLayout>
