---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import Button from "../components/ui/Button.astro";
import NumberField from "../components/ui/NumberField.astro";
import SelectField from "../components/ui/SelectField.astro";
import TextField from "../components/ui/TextField.astro";
import MunicipalityField from "../components/ui/MunicipalityField.astro";
import ResultCard from "../components/ui/ResultCard.astro";
import CalculationBreakdown from "../components/ui/CalculationBreakdown.astro";
import ScopeNotice from "../components/ui/ScopeNotice.astro";
import DataFreshness from "../components/ui/DataFreshness.astro";
import LeadForm from "../components/ui/LeadForm.astro";
import Logo from "../assets/brand/logo.svg";
import LogoWhite from "../assets/brand/logo-blanc.svg";
import Symbol from "../assets/brand/symbole.svg";
import {
	fieldControl,
	fieldFrame,
	fieldFramedInput,
	fieldHint,
	fieldLabel,
	fieldUnit,
} from "../components/ui/field-styles";
import { formatChf } from "../lib/format/chf";

// Page de démonstration du design system (docs/design-system.md) — NON liée
// depuis le site, noindex, hors sitemap. Montre chaque token et chaque
// composant de src/components/ui/, dans ses états. Tous les montants sont
// fictifs. Le calculateur complet assemblé vit sur /demo-calculateur/.

const municipalities = ["Lausanne", "Renens", "Nyon", "Morges", "Yverdon-les-Bains", "Pully", "Montreux"];

// Couleurs : nom du token et rôle, tels que tokens.css les déclare. La pastille
// lit la variable CSS : aucune valeur de couleur n'est recopiée ici.
const colors = [
	{ token: "ink", role: "Texte, titres, bouton secondaire, pied de page" },
	{ token: "ink-muted", role: "Texte secondaire, aide, métadonnées" },
	{ token: "paper", role: "Fond de page, cartes, champs" },
	{ token: "tint", role: "Sections alternées, panneaux, en-têtes de tableau" },
	{ token: "hairline", role: "Séparateurs décoratifs" },
	{ token: "rule", role: "Bordure des champs et contrôles" },
	{ token: "accent", role: "Résultat, liens, bouton principal, focus" },
	{ token: "accent-strong", role: "Survol et pression de l'accent" },
	{ token: "accent-tint", role: "Fond de la carte résultat, sélection, succès" },
	{ token: "brand", role: "Décor et graphiques uniquement, jamais du texte" },
	{ token: "slate", role: "Série de graphique complémentaire" },
	{ token: "slate-light", role: "Remplissages, série secondaire" },
	{ token: "success", role: "Confirmation — alias de l'accent" },
	{ token: "success-tint", role: "Fond d'une confirmation" },
	{ token: "warning", role: "Texte des avertissements renforcés" },
	{ token: "warning-signal", role: "Filet des avertissements, décoratif" },
	{ token: "warning-tint", role: "Fond des avertissements" },
	{ token: "error", role: "Erreurs uniquement, jamais un montant" },
	{ token: "error-tint", role: "Fond d'un champ ou d'un bandeau en erreur" },
];

const typeScale = [
	{ token: "text-display", element: "<output>", sample: `${formatChf(12480)}\u00a0CHF`, classes: "text-display text-accent tabular-nums" },
	{ token: "text-title", element: "<h1>", sample: "Rachat rétroactif du pilier 3a", classes: "text-title" },
	{ token: "text-heading", element: "<h2>", sample: "Comment nous vérifions", classes: "text-heading" },
	{ token: "text-subheading", element: "<h3>", sample: "Rachat dans le pilier 3a", classes: "text-subheading" },
	{ token: "text-lead", element: "chapeau", sample: "Chaque chiffre provient d'une source officielle datée.", classes: "text-lead text-ink-muted" },
	{ token: "text-body", element: "<p>", sample: "Le texte courant, en graisse 500, borné à 70 caractères.", classes: "text-body" },
	{ token: "text-label", element: "<label>, bouton", sample: "Revenu imposable cantonal", classes: "text-label font-bold" },
	{ token: "text-fine", element: "aide, source", sample: "Barèmes 2026, vérifiés le 08.01.2026.", classes: "text-fine text-ink-muted" },
];
---

<BaseLayout
	title="Démonstration du design system — calculateurs.ch"
	description="Page interne de contrôle visuel des composants d'interface."
	noindex={true}
>
	<Section hero={true}>
		<h1 class="max-w-reading text-title">Démonstration du design system</h1>
		<p class="mt-sm max-w-reading text-lead text-ink-muted">
			Palette « marine et sapin ». Chaque token et chaque composant de{" "}
			<code>src/components/ui/</code>, dans ses états. Spécification :{" "}
			<code>docs/design-system.md</code>. Le calculateur assemblé est sur{" "}
			<a href="/demo-calculateur/">/demo-calculateur/</a>. Page non référencée,
			absente de la navigation ; montants fictifs.
		</p>
	</Section>

	<Section tone="tint" class="flex flex-col gap-2xl">
		<h2 class="text-heading">Logo et icônes</h2>
		<ul class="grid gap-xl md:grid-cols-2">
			<li class="flex flex-col gap-sm">
				<div class="flex min-h-5xl items-center rounded-panel bg-paper p-xl">
					<Logo class="h-2xl w-auto max-w-full" aria-hidden="true" />
				</div>
				<p class="text-fine text-ink-muted"><code>logo.svg</code> — version principale, fond clair</p>
			</li>
			<li class="flex flex-col gap-sm">
				<div class="flex min-h-5xl items-center rounded-panel bg-ink p-xl">
					<LogoWhite class="h-2xl w-auto max-w-full" aria-hidden="true" />
				</div>
				<p class="text-fine text-ink-muted"><code>logo-blanc.svg</code> — fond encre ou foncé</p>
			</li>
			<li class="flex flex-col gap-sm">
				<div class="flex min-h-5xl items-center rounded-panel bg-ink p-xl">
					<img src="/brand/logo-blanc-pur.svg" alt="" class="h-2xl w-auto max-w-full" />
				</div>
				<p class="text-fine text-ink-muted"><code>logo-blanc-pur.svg</code> — une couleur, blanc</p>
			</li>
			<li class="flex flex-col gap-sm">
				<div class="flex min-h-5xl items-center rounded-panel bg-paper p-xl">
					<img src="/brand/logo-encre.svg" alt="" class="h-2xl w-auto max-w-full" />
				</div>
				<p class="text-fine text-ink-muted"><code>logo-encre.svg</code> — une couleur, encre</p>
			</li>
		</ul>
		<ul class="flex flex-wrap items-end gap-xl">
			<li class="flex flex-col items-start gap-sm">
				<Symbol class="size-4xl" aria-hidden="true" />
				<p class="text-fine text-ink-muted"><code>symbole.svg</code></p>
			</li>
			<li class="flex flex-col items-start gap-sm">
				<img src="/favicon.svg" alt="" class="size-2xl" />
				<p class="text-fine text-ink-muted"><code>favicon.svg</code></p>
			</li>
			<li class="flex flex-col items-start gap-sm">
				<img src="/favicon.ico" alt="" class="size-lg" />
				<p class="text-fine text-ink-muted"><code>favicon.ico</code></p>
			</li>
			<li class="flex flex-col items-start gap-sm">
				<img src="/apple-touch-icon.png" alt="" class="size-4xl" />
				<p class="text-fine text-ink-muted"><code>apple-touch-icon.png</code></p>
			</li>
		</ul>
	</Section>

	<Section class="flex flex-col gap-2xl">
		<h2 class="text-heading">Couleurs</h2>
		<ul class="grid gap-lg md:grid-cols-2 lg:grid-cols-3">
			{
				colors.map((color) => (
					<li class="flex items-start gap-md">
						<span
							class="size-3xl shrink-0 rounded-control border border-hairline"
							style={`background-color: var(--color-${color.token})`}
						/>
						<span class="flex flex-col">
							<code class="text-label font-bold">{color.token}</code>
							<span class="text-fine text-ink-muted">{color.role}</span>
						</span>
					</li>
				))
			}
		</ul>
	</Section>

	<Section tone="tint" class="flex flex-col gap-2xl">
		<h2 class="text-heading">Échelle typographique</h2>
		<ul class="flex flex-col gap-xl">
			{
				typeScale.map((level) => (
					<li class="flex flex-col gap-xs border-b border-hairline pb-lg">
						<span class="text-fine text-ink-muted">
							<code>{level.token}</code> · {level.element}
						</span>
						<span class={level.classes}>{level.sample}</span>
					</li>
				))
			}
		</ul>
	</Section>

	<Section class="flex flex-col gap-2xl">
		<h2 class="text-heading">Boutons</h2>
		<p class="max-w-reading text-body">
			Survol et pression se vérifient à la souris ; le focus, au clavier (touche
			Tab).
		</p>
		<div class="flex flex-col gap-xl">
			<div class="flex flex-wrap items-center gap-md">
				<Button>Calculer</Button>
				<Button variant="secondary">Voir le détail</Button>
				<Button variant="ghost">Réinitialiser</Button>
			</div>
			<div class="flex flex-wrap items-center gap-md">
				<Button disabled={true}>Calculer</Button>
				<Button variant="secondary" disabled={true}>Voir le détail</Button>
				<Button variant="ghost" disabled={true}>Réinitialiser</Button>
				<Button disabled={true} aria-busy="true">Envoi…</Button>
			</div>
			<div class="flex flex-wrap items-center gap-md">
				<Button size="sm" variant="secondary">Petit</Button>
				<Button size="md">Moyen</Button>
				<Button size="lg">Grand</Button>
				<Button href="/demo-calculateur/" variant="secondary">Lien en bouton</Button>
			</div>
			<div class="flex flex-wrap items-center gap-md rounded-panel bg-ink p-xl">
				<Button variant="inverse">Inversé, sur encre</Button>
			</div>
		</div>
	</Section>

	<Section tone="tint" class="flex flex-col gap-2xl">
		<h2 class="text-heading">Champs</h2>
		<div class="grid gap-2xl lg:grid-cols-2">
			<form class="flex flex-col gap-xl" novalidate>
				<h3 class="text-subheading">Au repos</h3>
				<NumberField
					id="demo-number"
					name="demoNumber"
					label="Revenu net imposable"
					value="85000"
					unit="CHF"
					hint="Montant fictif."
					required
				/>
				<SelectField
					id="demo-select"
					name="demoSelect"
					label="Situation de famille"
					options={[
						{ value: "single", label: "Personne seule" },
						{ value: "married", label: "Marié·e, imposition commune" },
						{ value: "family", label: "Famille monoparentale" },
					]}
					value="married"
				/>
				<TextField id="demo-text" name="demoText" label="Âges des enfants" hint="Séparés par des virgules." />
				<MunicipalityField
					id="demo-municipality"
					name="demoMunicipality"
					label="Commune"
					options={municipalities}
					hint="Autocomplétion native, sans îlot hydraté."
				/>
			</form>

			<form class="flex flex-col gap-xl" novalidate>
				<h3 class="text-subheading">Focus, erreur, désactivé</h3>
				<div class="flex flex-col gap-xs">
					<label for="demo-focus" class={fieldLabel}>Focus (simulé)</label>
					<p class={fieldHint}>Bordure et anneau accent ; au clavier, le vrai focus est identique.</p>
					<div class:list={[fieldFrame.replace("border-rule", "border-accent"), "outline-2 outline-accent"]}>
						<input id="demo-focus" type="number" value="5000" class={fieldFramedInput} />
						<span class={fieldUnit}>CHF</span>
					</div>
				</div>

				<div class="flex flex-col gap-xs">
					<label for="demo-error" class={fieldLabel}>Revenu annuel brut</label>
					<p id="demo-error-hint" class={fieldHint}>Salaire AVS, avant déductions.</p>
					<div class={fieldFrame}>
						<input
							id="demo-error"
							type="number"
							value="-500"
							aria-invalid="true"
							aria-describedby="demo-error-hint demo-error-message"
							class={fieldFramedInput}
						/>
						<span class={fieldUnit}>CHF</span>
					</div>
					<p id="demo-error-message" class="text-fine font-bold text-error">
						Erreur : indiquez un montant positif.
					</p>
				</div>

				<div class="flex flex-col gap-xs">
					<label for="demo-disabled" class={fieldLabel}>Désactivé</label>
					<div class={fieldFrame}>
						<input id="demo-disabled" type="number" value="12000" disabled class={fieldFramedInput} />
						<span class={fieldUnit}>CHF</span>
					</div>
				</div>

				<div class="flex flex-col gap-xs">
					<label for="demo-select-disabled" class={fieldLabel}>Liste désactivée</label>
					<select id="demo-select-disabled" disabled class={fieldControl}>
						<option>Vaud</option>
					</select>
				</div>

				<fieldset class="flex flex-col gap-sm">
					<legend class="mb-sm text-subheading">Choix binaire en pastilles</legend>
					<div class="flex flex-wrap gap-sm">
						<label
							class="flex min-h-3xl cursor-pointer items-center gap-sm rounded-button border border-rule px-lg text-label has-[:checked]:border-accent has-[:checked]:bg-accent-tint has-[:checked]:text-ink"
						>
							<input type="radio" name="demoStatus" value="single" checked class="size-icon" />
							Personne seule
						</label>
						<label
							class="flex min-h-3xl cursor-pointer items-center gap-sm rounded-button border border-rule px-lg text-label has-[:checked]:border-accent has-[:checked]:bg-accent-tint has-[:checked]:text-ink"
						>
							<input type="radio" name="demoStatus" value="married" class="size-icon" />
							Marié·e
						</label>
					</div>
				</fieldset>

				<label class="flex items-center gap-sm text-label">
					<input type="checkbox" checked class="size-icon" />
					Case à cocher native
				</label>
			</form>
		</div>
	</Section>

	<Section class="flex flex-col gap-2xl">
		<h2 class="text-heading">Résultat et sources</h2>
		<div class="grid gap-2xl lg:grid-cols-[2fr_3fr]">
			<div class="flex flex-col gap-md">
				<p class="max-w-reading text-body">
					La carte résultat est l'élément le plus grand et le plus contrasté de la
					page.
				</p>
				<p class="flex flex-wrap gap-sm">
					<span class="inline-flex items-center rounded-button bg-accent-tint px-sm text-fine font-bold text-accent">
						Données 2026
					</span>
					<span class="inline-flex items-center rounded-button bg-tint px-sm text-fine font-bold text-ink">
						Pastille neutre
					</span>
				</p>
			</div>
			<ResultCard
				id="demo-result"
				for="demo-number"
				label="Économie d'impôt"
				value={`${formatChf(1842)}\u00a0CHF`}
				caption="Montant fictif, pour le rendu."
			/>
		</div>
		<CalculationBreakdown
			open={true}
			rows={[
				{ label: "Revenu imposable", detail: "Saisi", amount: `${formatChf(85000)}\u00a0CHF` },
				{
					label: "Déduction",
					detail: `${formatChf(85000)} − ${formatChf(5000)}`,
					amount: `${formatChf(80000)}\u00a0CHF`,
					note: "Hypothèse ou référence de barème, en légende.",
				},
				{ label: "Lacune 2024", detail: `max(0 ; ${formatChf(5000)} − ${formatChf(5000)})`, amount: "0\u00a0CHF", qualifier: "non rachetable" },
				{ label: "Impôt dû", detail: "Barème fictif", amount: `${formatChf(9480)}\u00a0CHF` },
			]}
		/>
		<DataFreshness referenceYear={2026} verifiedOn="2026-01-08" />
		<DataFreshness referenceYear={2026} verifiedOn="" />
	</Section>

	<Section class="flex flex-col gap-2xl">
		<h2 class="text-heading">Avis</h2>
		<h3 class="text-subheading">Avis informatif</h3>
		<ScopeNotice
			forWhom={["Propriétaire d'un logement en résidence principale"]}
			notCovered={[
				{
					case: "Immeubles de rendement",
					alternative: { label: "Renseignez-vous auprès de l'administration fiscale de votre canton." },
				},
			]}
			assumptions={["Valeur locative selon la dernière estimation cantonale."]}
		/>
		<h3 class="text-subheading">Avertissement renforcé (calculateurs A4, B3, C1)</h3>
		<ScopeNotice
			reinforced={true}
			forWhom={["Personne envisageant un retrait en capital du 2e pilier"]}
			notCovered={[
				{
					case: "Rentes viagères",
					alternative: { label: "Consultez votre caisse de pension." },
				},
			]}
			assumptions={["Un retrait en capital est irréversible et modifie durablement la rente."]}
		/>
		<h3 class="text-subheading">Succès et erreur</h3>
		<p class="max-w-reading rounded-panel bg-success-tint p-lg text-label text-ink">
			<strong class="font-bold">Envoyé : </strong>la demande est partie. Le partenaire vous
			recontacte directement.
		</p>
		<p role="alert" class="max-w-reading rounded-panel bg-error-tint p-lg text-label text-ink">
			<strong class="font-bold text-error">Erreur : </strong>l'envoi a échoué. Votre résultat
			reste affiché.
		</p>
	</Section>

	<Section tone="tint" class="flex flex-col gap-2xl">
		<h2 class="text-heading">Tableau</h2>
		<div class="overflow-x-auto rounded-panel border border-hairline bg-paper">
			<table class="w-full border-collapse text-label">
				<caption class="caption-top px-md py-sm text-left text-fine text-ink-muted">
					Barème fictif, pour le rendu
				</caption>
				<thead>
					<tr class="bg-tint text-left font-bold">
						<th scope="col" class="border-b border-hairline px-md py-sm">Tranche</th>
						<th scope="col" class="border-b border-hairline px-md py-sm text-right">Revenu dès</th>
						<th scope="col" class="border-b border-hairline px-md py-sm text-right">Taux</th>
						<th scope="col" class="border-b border-hairline px-md py-sm text-right">Impôt de base</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<th scope="row" class="border-b border-hairline px-md py-sm text-left font-medium">1</th>
						<td class="border-b border-hairline px-md py-sm text-right tabular-nums">0</td>
						<td class="border-b border-hairline px-md py-sm text-right tabular-nums">1,00&nbsp;%</td>
						<td class="border-b border-hairline px-md py-sm text-right tabular-nums">0</td>
					</tr>
					<tr>
						<th scope="row" class="border-b border-hairline px-md py-sm text-left font-medium">2</th>
						<td class="border-b border-hairline px-md py-sm text-right tabular-nums">{formatChf(20000)}</td>
						<td class="border-b border-hairline px-md py-sm text-right tabular-nums">5,00&nbsp;%</td>
						<td class="border-b border-hairline px-md py-sm text-right tabular-nums">200</td>
					</tr>
					<tr class="font-bold">
						<th scope="row" class="border-t-2 border-ink px-md py-sm text-left">Total</th>
						<td class="border-t-2 border-ink px-md py-sm text-right tabular-nums"></td>
						<td class="border-t-2 border-ink px-md py-sm text-right tabular-nums"></td>
						<td class="border-t-2 border-ink px-md py-sm text-right tabular-nums">200</td>
					</tr>
				</tbody>
			</table>
		</div>
	</Section>

	<Section class="flex flex-col gap-2xl">
		<h2 class="text-heading">Mise en relation</h2>
		<LeadForm
			partner="une fiduciaire partenaire"
			purpose="Vous mettre en relation pour un bilan fiscal complet. Un seul partenaire, aucune revente."
		/>
	</Section>
</BaseLayout>
