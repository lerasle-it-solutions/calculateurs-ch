---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/layout/PageHero.astro";
import Section from "../components/layout/Section.astro";
import { fr } from "../i18n/fr";
import { publishedCalculators } from "../calculators/catalog";
import {
  FAMILY_ORDER,
  familyHasPage,
  familyUrl,
} from "../calculators/families";

const title = `${fr.site.name} — calculateurs suisses romands qui affichent leurs sources`;
const description =
  "Calculateurs de fiscalité et de prévoyance pour la Suisse romande, chaque chiffre sourcé et daté. Aucun compte, aucun cookie de suivi.";

// Généré depuis le catalogue : seuls les calculateurs publiés sont listés, en
// liens ; les familles sans calculateur publié tiennent en une seule ligne,
// sans date promise.
const families = FAMILY_ORDER.map((family) => ({
  family,
  calculators: publishedCalculators(family),
}));
const withCalculators = families.filter(({ calculators }) => calculators.length > 0);
const comingSoon = families
  .filter(({ calculators }) => calculators.length === 0)
  .map(({ family }) => fr.family[family]);
---

<BaseLayout title={title} description={description}>
  <PageHero
    title={fr.site.name}
    lead={[
      fr.site.baseline,
      "Chaque chiffre utilisé provient d'une source officielle, avec sa date de vérification. Aucun compte, aucun cookie de suivi, aucune publicité. Vos données ne quittent pas votre navigateur.",
    ]}
  />

  <Section tone="tint" id="calculateurs" class="flex flex-col gap-xl">
    <ul class="grid gap-xl md:grid-cols-2">
      {
        withCalculators.map(({ family, calculators }) => (
          <li class="flex h-full flex-col gap-md rounded-panel bg-paper p-xl">
            <h2 class="text-subheading">{fr.family[family]}</h2>
            <ul class="flex flex-col gap-sm text-body">
              {calculators.map((calculator) => (
                <li>
                  <a href={calculator.slug}>{calculator.title}</a>
                </li>
              ))}
            </ul>
            {familyHasPage(family) && (
              <a
                href={familyUrl(family)}
                class="mt-auto text-label font-bold text-accent"
              >
                {fr.home.familyCardAction}
              </a>
            )}
          </li>
        ))
      }
    </ul>
    {
      comingSoon.length > 0 && (
        <p data-home-coming-soon class="text-fine text-ink-muted">
          {fr.home.comingSoon(comingSoon)}
        </p>
      )
    }
  </Section>
</BaseLayout>
