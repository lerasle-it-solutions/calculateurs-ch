---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'calculateurs.ch — calculateurs suisses romands qui affichent leurs sources';
const description =
	'Des calculateurs de prévoyance, immobilier, énergie et entreprise pour la Suisse romande. Chaque chiffre provient d’une source officielle datée. Aucun compte, aucun cookie.';

const families = [
	{
		name: 'Prévoyance',
		items: ['3e pilier', 'Rachats LPP', 'Retrait en capital'],
	},
	{
		name: 'Immobilier',
		items: ['Valeur locative', 'Rénovation', 'Capacité d’achat'],
	},
	{
		name: 'Énergie',
		items: ['Subventions cantonales et communales', 'Pompe à chaleur', 'Photovoltaïque'],
	},
	{
		name: 'Entreprise',
		items: ['Coût employeur', 'Charges sociales'],
	},
];
---

<BaseLayout title={title} description={description}>
	<div class="flex flex-col gap-2xl">
		<header class="flex flex-col gap-md">
			<h1 class="text-title">calculateurs.ch</h1>
			<p class="text-body">
				Des calculateurs suisses romands qui affichent leurs sources.
			</p>
			<p class="text-body">
				Chaque chiffre utilisé provient d'une source officielle, avec sa date de
				vérification. Aucun compte, aucun cookie, aucune publicité. Vos données ne
				quittent pas votre navigateur.
			</p>
		</header>

		<div class="flex flex-col gap-xl">
			{
				families.map((family) => (
					<section class="flex flex-col gap-sm">
						<h2 class="text-heading">{family.name}</h2>
						<ul class="flex list-disc flex-col gap-2xs pl-lg text-body">
							{family.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</section>
				))
			}
		</div>

		<p class="border-t border-rule pt-lg font-serif text-fine">
			Premiers calculateurs en ligne dès octobre 2026.
		</p>
	</div>
</BaseLayout>
