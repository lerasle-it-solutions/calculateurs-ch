---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/layout/Section.astro";
import { attributionTextsFor } from "../lib/attribution";
import { sourceFreshnessReport } from "../lib/data-report";
import { ROMANDE_CANTONS } from "../calculators/cantons";
import { getCantonData, getFederalData, getMunicipalMultipliers, latestFederalYear } from "../data";
import { fr } from "../i18n/fr";

const title = `${fr.footer.methodology} — ${fr.site.name}`;
// Texte d'attribution du module de données de base de l'AFC, tel que le registre le porte
const [estvAttribution] = attributionTextsFor(["estv-base-data-module"]);
const description =
	"D'où viennent les chiffres, comment nous les vérifions contre le calculateur de l'AFC, le moteur fiscal, les mises à jour et les corrections.";

const numberFormat = new Intl.NumberFormat("fr-CH");
const dateFormat = new Intl.DateTimeFormat("fr-CH", { day: "2-digit", month: "2-digit", year: "numeric" });
const formatDate = (isoDate: string): string => dateFormat.format(new Date(`${isoDate}T00:00:00Z`));

// Familles de barèmes, telles que déclarées table par table dans src/data/cantons/
const scaleTypeLabels: Record<string, string> = {
	marginal: "par tranches, chaque tranche à son taux marginal",
	averageRate: "taux moyen de la tranche, appliqué au montant entier",
	interpolated: "taux moyen interpolé entre les lignes du barème, appliqué au montant entier",
};
const scaleTypesOf = (scale: { table: { value: { scaleType: string } } }[]): string =>
	[...new Set(scale.map((entry) => entry.table.value.scaleType))].map((type) => scaleTypeLabels[type] ?? type).join(" ; ");
const scaleFamilies = ROMANDE_CANTONS.map(({ code, name }) => {
	const data = getCantonData(code);
	return {
		name,
		income: scaleTypesOf(data.incomeTaxScale),
		communal: data.communalScale === null ? null : scaleTypesOf(data.communalScale.income),
		wealth: scaleTypesOf(data.wealthTaxScale),
	};
});

// Quotient familial vaudois : parts lues dans les données
const vaudFamily = getCantonData("VD").familyModel;
const vaudParts =
	"type" in vaudFamily && vaudFamily.type === "familyQuotient" && "value" in vaudFamily.coefficients
		? vaudFamily.coefficients.value
		: null;

// Valais : communes couvertes, celles dont l'indexation du barème communal est relevée
const valaisCovered = (getMunicipalMultipliers()?.multipliers ?? [])
	.filter((entry) => entry.canton === "VS" && entry.communalScaleIndexation !== undefined)
	.map((entry) => entry.municipality)
	.sort((a, b) => a.localeCompare(b, "fr"));

// Rachat 3a : règles lues dans les données fédérales
const pillar3a = getFederalData(latestFederalYear()).pillar3a;

// Partie générée : sources des calculateurs de prévoyance, d'après `usedBy`
const UNOFFICIAL_NATURES = ["self-regulation", "industry", "association"];
const pensionSources = sourceFreshnessReport().filter((row) =>
	row.source?.usedBy.some((usage) => usage.startsWith("pension.")),
);
---

<BaseLayout title={title} description={description}>
		<Section hero={true}>
			<h1 class="max-w-reading text-title">{fr.footer.methodology}</h1>
			<p class="mt-sm max-w-reading text-lead text-ink-muted">
				Ce site n'est pas un formulaire à devis déguisé. Chaque résultat est
				accompagné du détail ligne par ligne du calcul et de ses hypothèses, et
				chaque chiffre utilisé provient d'une source officielle datée. Cette page
				décrit comment.
			</p>
			<p class="mt-md max-w-reading text-lead text-ink-muted">
				Le code et les données sont publics sur <a
					href="https://github.com/lerasle-it-solutions/calculateurs-ch"
					>GitHub</a
				> — vous pouvez y vérifier vous-même chaque valeur et chaque formule.
			</p>
		</Section>

		<Section tone="tint" id="sources" class="flex flex-col gap-lg">
			<h2 class="text-heading">D'où viennent les chiffres</h2>
			<p class="max-w-reading text-body">
				Aucune valeur chiffrée — barème, plafond, taux, seuil, coût de référence,
				tarif — n'est écrite en dur dans le code du site. Toutes vivent dans une
				couche de données séparée, où chaque valeur est enveloppée avec, au
				minimum :
			</p>
			<ul class="flex max-w-reading list-disc flex-col gap-2xs pl-lg text-body">
				<li>la valeur elle-même et son unité ;</li>
				<li>
					un identifiant de source pointant vers un texte officiel enregistré
					dans un registre central ;
				</li>
				<li>la date à laquelle un humain a relevé cette valeur à sa source ;</li>
				<li>la date d'entrée en vigueur.</li>
			</ul>
			<p class="max-w-reading text-body">
				Chaque valeur suit la même hiérarchie. La source est toujours l'acte
				officiel qui la fixe : loi fiscale cantonale pour un barème, arrêté
				communal pour un coefficient, ordonnance fédérale pour un plafond.
				L'outil qui a servi à la relever — un module de téléchargement, une
				notice d'administration — est noté à part, comme outil de collecte : il
				n'est jamais la source. Vient enfin la vérification, datée, décrite plus
				bas. Une valeur est toujours relevée à sa source : on ne la déduit pas,
				on ne l'estime pas, on ne la recopie pas de mémoire. Si une valeur
				manque, le calculateur qui en dépend reste bloqué jusqu'à ce qu'elle soit
				relevée — il n'est jamais publié avec un chiffre approché.
			</p>
			<p class="max-w-reading text-body">
				Les barèmes cantonaux et les coefficients communaux sont relevés dans le
				module « Rechercher des données de base » du simulateur fiscal de
				l'Administration fédérale des contributions (AFC), dont l'AFC autorise
				la réutilisation à condition d'en citer la source et sans garantie. Les
				résultats du calculateur de l'AFC, eux, ne sont jamais reproduits : ils
				servent uniquement à vérifier nos calculs. Tout résultat qui s'appuie sur
				ces données porte la mention suivante :
			</p>
			<p class="max-w-reading border-l-2 border-hairline pl-md text-fine text-ink-muted">{estvAttribution}</p>
			<p class="max-w-reading text-body">
				Quelques chiffres ne viennent pas d'une autorité : directives
				d'autorégulation bancaire, prix indicatifs publiés par une branche ou
				une association professionnelle. Ils sont toujours signalés comme
				tels, avec la mention « source non officielle, à titre indicatif », et
				ne sont jamais présentés comme du droit.
			</p>
			<p class="max-w-reading text-body">
				Certaines données sont compilées à la main, commune par commune ou
				fournisseur par fournisseur — subventions à la rénovation, tarifs de
				reprise de l'électricité solaire. Elles ne sont pas publiées sous forme
				brute : seuls les résultats calculés pour votre situation s'affichent.
				Leur existence n'est pas cachée pour autant : la page <a href="/donnees/"
					>Données et sources</a
				> en donnera l'inventaire — nature, couverture et date de mise à jour,
				jamais les valeurs — dès qu'un calculateur les utilisera.
			</p>
		</Section>

		<Section tone="paper" id="verification" class="flex flex-col gap-lg">
			<h2 class="text-heading">Comment nous vérifions</h2>
			<p class="max-w-reading text-body">
				Là où un simulateur officiel existe, il fait autorité et nous ne
				cherchons pas à le battre. Le moteur fiscal est comparé au calculateur
				d'impôts de l'<a href="https://www.estv.admin.ch/"
					>Administration fédérale des contributions</a
				>, sur des cas de référence saisis à la main dans son interface web :
			</p>
			<ul class="flex max-w-reading list-disc flex-col gap-2xs pl-lg text-body">
				<li>
					dix-huit cas de niveau, trois par canton romand — deux personnes
					seules sans enfant et un couple marié avec un enfant —, qui comparent
					l'impôt cantonal, l'impôt communal, l'impôt fédéral direct et le
					total ;
				</li>
				<li>
					sept cas différentiels, qui comparent une économie d'impôt : le même
					profil, saisi une seconde fois avec un revenu imposable diminué d'un
					rachat dans le pilier 3a.
				</li>
			</ul>
			<p class="max-w-reading text-body">
				Sur les montants, la tolérance est de 1&nbsp;%, avec un plancher d'un
				franc ; la taxe personnelle et l'impôt paroissial doivent être
				identiques. Sur la pente — l'impôt supplémentaire pour 1&nbsp;000 francs
				de revenu imposable —, elle est d'un demi-point. Ces cas sont rejoués à
				chaque modification du moteur ou des barèmes, et avant chaque
				publication : nous lançons la suite de tests complète avant de verser
				une version dans la branche publiée, et une version dont un cas sort de
				la tolérance n'y est pas versée. La publication elle-même est
				automatique et ne rejoue pas ces tests.
			</p>
			<p class="max-w-reading text-body">
				Le Valais n'est couvert qu'en partie. Le moteur ne reproduit pas
				encore l'abattement accordé aux couples mariés et aux familles
				monoparentales ; il ne calcule donc que pour les personnes seules sans
				enfant, et seulement dans les communes dont l'indexation du barème
				communal a été relevée ({valaisCovered.join(", ")}). Pour les autres
				situations, il ne rend aucun résultat et renvoie à la calculette
				officielle du canton. Le cas de référence valaisan d'un couple marié
				avec enfant est conservé : il vérifie que le moteur refuse bien de
				calculer.
			</p>
			<p class="max-w-reading text-body">
				Ces cas de référence ne sont pas publiés. L'AFC autorise la
				réutilisation de ses données de base, mais les résultats de son
				calculateur ne sont pas des données ouvertes et ne se consultent que par
				son interface web. Ils sont conservés dans un dépôt privé et servent
				uniquement à tester nos calculs.
			</p>
		</Section>

		<Section tone="tint" id="moteur-fiscal" class="flex flex-col gap-lg">
			<h2 class="text-heading">Le moteur fiscal</h2>
			<p class="max-w-reading text-body">
				Nous ne publions pas de simulateur d'impôt cantonal : les simulateurs
				officiels sont gratuits et font autorité. Le moteur fiscal sert les
				calculateurs de prévoyance et de logement, qui ont besoin de savoir ce
				que coûte ou rapporte une décision.
			</p>
			<p class="max-w-reading text-body">
				<strong>Deux revenus imposables, pas un.</strong> La loi sur
				l'harmonisation des impôts directs laisse aux cantons les barèmes, les
				taux et les montants des déductions ; l'impôt fédéral direct applique
				ses propres déductions. Un même revenu net donne donc un revenu
				imposable cantonal et un revenu imposable fédéral différents, chacun
				taxé par son barème. Les calculateurs vous demandent les deux, tels
				qu'ils figurent sur votre décision de taxation.
			</p>
			<p class="max-w-reading text-body">
				<strong>Trois étages.</strong> Le revenu imposable cantonal passe par le
				barème cantonal, qui donne l'impôt cantonal de base. Cet impôt de base
				est multiplié par le coefficient cantonal, puis par le coefficient
				communal et, le cas échéant, paroissial. Le revenu imposable fédéral
				passe par le barème de l'impôt fédéral direct. S'y ajoutent la taxe
				personnelle forfaitaire là où elle existe, et les corrections
				cantonales datées, comme la réduction annuelle de l'impôt cantonal de
				base vaudois. Les arrondis officiels sont reproduits — certaines étapes
				arrondissent le revenu à la centaine de francs inférieure — et chaque
				arrondi apparaît dans le détail du calcul.
			</p>
			<p class="max-w-reading text-body">
				<strong>Deux familles de barèmes.</strong> Un barème par tranches
				applique à chaque tranche son taux marginal ; un barème à taux moyen lit
				un taux à la hauteur du revenu et l'applique au revenu entier. Voici les
				barèmes de l'année tels que nous les avons relevés, table par table :
			</p>
			<div class="overflow-x-auto rounded-panel border border-hairline bg-paper">
				<table class="w-full border-collapse text-label">
					<caption class="caption-top px-md py-sm text-left text-fine text-ink-muted">
						Familles de barèmes du revenu et de la fortune, par canton
					</caption>
					<thead>
						<tr class="bg-tint text-left font-bold">
							<th scope="col" class="border-b border-hairline px-md py-sm">Canton</th>
							<th scope="col" class="border-b border-hairline px-md py-sm">Revenu</th>
							<th scope="col" class="border-b border-hairline px-md py-sm">Fortune</th>
						</tr>
					</thead>
					<tbody>
						{
							scaleFamilies.map((row) => (
								<tr class="align-top">
									<th scope="row" class="border-b border-hairline px-md py-sm text-left font-bold">{row.name}</th>
									<td class="border-b border-hairline px-md py-sm">
										{row.income}
										{row.communal && <span class="block">commune : {row.communal}</span>}
									</td>
									<td class="border-b border-hairline px-md py-sm">{row.wealth}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
			<p class="max-w-reading text-body">
				<strong>Le quotient familial vaudois n'est pas un splitting.</strong> Un
				splitting divise le revenu des époux par un diviseur fixe pour lire le
				taux. À Vaud, le revenu imposable est divisé par un nombre de parts qui
				dépend de toute la famille{
					vaudParts && (
						<>
							{" "}— {numberFormat.format(vaudParts.single)} pour une personne
							seule, {numberFormat.format(vaudParts.married)} pour des époux,{" "}
							{numberFormat.format(vaudParts.singleWithChildren)} pour un parent
							seul, plus {numberFormat.format(vaudParts.perChild)} par enfant
						</>
					)
				} ; le taux lu sur ce quotient s'applique ensuite au revenu entier, et
				la réduction obtenue grâce aux parts d'enfants est plafonnée. Comme le
				quotient est arrondi, le revenu qui détermine le taux avance par
				marches : c'est pourquoi la pente se mesure sur 1&nbsp;000 francs, et
				non sur 100.
			</p>
			<p class="max-w-reading text-body">
				<strong>Les communes valaisannes ont leur propre barème.</strong> Ailleurs
				en Suisse romande, l'impôt communal est un coefficient appliqué à
				l'impôt cantonal de base. En Valais, chaque commune applique le barème
				communal, adapté par son propre coefficient d'indexation, puis son
				coefficient communal : l'impôt communal ne se déduit pas de l'impôt
				cantonal.
			</p>
			<p class="max-w-reading text-body">
				<strong>Ce que le moteur ne couvre pas.</strong> L'impôt à la source,
				les prestations en capital, les gains immobiliers et, en Valais, les
				situations décrites plus haut. Chaque calculateur annonce son périmètre
				avant la saisie, avec une alternative pour les cas qu'il ne traite pas.
			</p>
		</Section>

		<Section tone="paper" id="prevoyance" class="flex flex-col gap-lg">
			<h2 class="text-heading">Prévoyance</h2>
			<h3 class="text-subheading">Rachat dans le pilier 3a</h3>
			<p class="max-w-reading text-body">
				Depuis la modification de l'ordonnance sur la prévoyance individuelle
				liée (OPP 3), une année où vous n'avez pas versé la cotisation maximale
				au pilier 3a laisse une lacune que vous pouvez combler plus tard. Les
				lacunes rachetables commencent en {pillar3a.buyback.firstGapYear.value} ;
				chacune peut être rachetée pendant les{" "}
				{numberFormat.format(pillar3a.buyback.lookbackYears.value)} années qui
				suivent. Le total des rachats d'une même année est plafonné à la
				« petite » cotisation de cette année ({numberFormat.format(pillar3a.smallContributionCap.value)}&nbsp;CHF
				en {latestFederalYear()}), quel que soit le nombre de lacunes comblées. Il
				faut un revenu soumis à l'AVS l'année de la lacune et l'année du
				rachat, et la cotisation de l'année du rachat doit être versée
				entièrement. Une année ne se rachète qu'une fois : une lacune comblée en
				partie ne peut plus être complétée. La limite d'âge n'est pas examinée
				par le calculateur.
			</p>
			<p class="max-w-reading text-body">
				<strong>Répartition par années entières.</strong> Comme une lacune
				entamée est perdue pour le solde, le calculateur ne propose jamais d'en
				entamer une qui pourrait encore attendre. L'année dont le délai expire
				l'année du rachat passe d'abord, entière si elle tient sous le plafond,
				sinon jusqu'au plafond : son solde serait perdu de toute façon. Le
				plafond restant va à l'ensemble d'années entières dont la somme est la
				plus élevée et, à égalité, aux années qui expirent le plus tôt. Les
				autres restent rachetables jusqu'à leur dernière année.
			</p>
			<p class="max-w-reading text-body">
				<strong>Une économie par différence de deux impôts.</strong> L'économie
				affichée est l'impôt calculé sur votre situation moins l'impôt calculé
				avec les deux revenus imposables, cantonal et fédéral, diminués du
				rachat. Elle ne s'obtient jamais en multipliant un taux marginal par le
				montant du rachat : une déduction de plusieurs milliers de francs peut
				franchir une limite de barème, ou une marche du quotient familial, ce
				qu'un taux marginal ne voit pas. Chaque composante de l'impôt est
				arrondie au franc, et l'économie est la différence des totaux affichés.
				L'impôt sur la fortune, que le rachat ne change pas, n'est pas calculé.
			</p>
			<p class="max-w-reading text-body">
				Sources rattachées aux calculateurs de prévoyance ; l'ensemble des
				sources, moteur fiscal compris, figure sur la page <a href="/donnees/"
					>Données et sources</a
				> :
			</p>
			<ul class="flex max-w-reading flex-col gap-xs border-l-2 border-hairline pl-md text-fine text-ink-muted">
				{
					pensionSources.map((row) => (
						<li>
							{row.source?.name}
							{row.source?.legalReference && <>, {row.source.legalReference}</>}
							{row.oldestVerifiedOn && (
								<>
									{" "}— vérifiée le{" "}
									<time datetime={row.oldestVerifiedOn}>{formatDate(row.oldestVerifiedOn)}</time>
								</>
							)}
							{row.source && UNOFFICIAL_NATURES.includes(row.source.nature) && (
								<> (source non officielle, à titre indicatif)</>
							)}
						</li>
					))
				}
			</ul>
		</Section>

		<Section tone="tint" class="flex flex-col gap-lg">
			<h2 class="text-heading">Politique de mise à jour</h2>
			<p class="max-w-reading text-body">
				La couche de données porte une dette de fraîcheur, et cette dette est
				publique : la page <a href="/donnees/">Données et sources</a> liste
				chaque valeur, sa date de vérification et l'échéance de sa prochaine
				relecture, triées par urgence.
			</p>
			<ul class="flex max-w-reading list-disc flex-col gap-2xs pl-lg text-body">
				<li>
					Un test de build échoue si une valeur n'a pas été re-vérifiée à sa
					source depuis plus de douze mois. Afficher un chiffre périmé avec
					assurance serait le seul défaut fatal du site ; le build refuse donc de
					passer.
				</li>
				<li>
					Chaque 1<sup>er</sup> janvier, les barèmes fédéraux de l'année sont
					dupliqués pour l'année suivante, toutes les dates de vérification sont
					remises à zéro et la liste des valeurs à re-contrôler est produite.
				</li>
				<li>
					Les révisions cantonales et communales sont suivies au fil des
					publications officielles, selon la cadence propre à chaque source.
				</li>
			</ul>
		</Section>

		<Section tone="paper" class="flex flex-col gap-lg">
			<h2 class="text-heading">Politique de correction d'erreur</h2>
			<p class="max-w-reading text-body">
				Une erreur peut porter sur une valeur relevée, sur une formule ou sur une
				hypothèse. Dans les trois cas :
			</p>
			<ul class="flex max-w-reading list-disc flex-col gap-2xs pl-lg text-body">
				<li>
					toute erreur signalée sur une valeur officielle est corrigée sous 48
					heures ;
				</li>
				<li>
					la correction est publiée avec sa date, et la valeur ou la formule
					concernée est re-vérifiée à sa source officielle ;
				</li>
				<li>
					si une valeur erronée a pu fausser un résultat, les calculateurs
					concernés le signalent le temps que la correction soit vérifiée ;
				</li>
				<li>
					les corrections sont consignées, de sorte qu'on puisse toujours savoir
					ce qui a changé et quand.
				</li>
			</ul>
			<p class="max-w-reading text-body">
				Pour signaler une erreur : ouvrez <a
					href="https://github.com/lerasle-it-solutions/calculateurs-ch/issues"
					>une issue sur GitHub</a
				> ou écrivez à <a href="mailto:contact@calculateurs.ch"
					>contact@calculateurs.ch</a
				>.
			</p>
		</Section>

		<Section tone="tint" class="flex flex-col gap-lg">
			<h2 class="text-heading">Les trois niveaux d'avertissement</h2>
			<p class="max-w-reading text-body">
				Un calculateur annonce ses limites avant la saisie, jamais après. Trois
				niveaux se superposent, du plus général au plus spécifique.
			</p>

			<div class="flex flex-col gap-md">
				<div class="flex flex-col gap-2xs">
					<h3 class="text-subheading">Niveau 1 — avertissement général du site</h3>
					<p class="max-w-reading text-body">
						Présent sur chaque calculateur : le résultat est une estimation
						indicative fondée sur des barèmes officiels datés. Il ne remplace ni
						une décision de taxation, ni l'avis d'un professionnel tenant compte
						de votre situation complète.
					</p>
				</div>

				<div class="flex flex-col gap-2xs">
					<h3 class="text-subheading">Niveau 2 — périmètre déclaré du calculateur</h3>
					<p class="max-w-reading text-body">
						Un bandeau au-dessus de chaque formulaire indique pour qui le
						calculateur est fait, ce qu'il ne couvre pas — avec un lien vers une
						alternative — et les hypothèses qu'il retient. Il s'affiche avant
						toute saisie.
					</p>
				</div>

				<div class="flex flex-col gap-2xs">
					<h3 class="text-subheading">Niveau 3 — avertissement renforcé</h3>
					<p class="max-w-reading text-body">
						Pour les calculateurs qui portent sur une décision difficilement
						réversible — un retrait en capital du 2<sup>e</sup> pilier, par
						exemple — un encart distinct rappelle que la décision est durable et
						invite explicitement à consulter un conseiller avant d'agir.
					</p>
				</div>
			</div>
