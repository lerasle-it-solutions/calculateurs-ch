---
/**
 * ArticleSchema — JSON-LD schema.org/Article d'un guide. Auteur et éditeur :
 * l'éditeur du site, déclaré sur l'accueil, jamais une personne.
 *
 * Rien que la page ne dise (tests/seo/bing.test.ts) : le titre est le H1, la
 * description est la méta-description, les dates sont celles de la ligne
 * « Publié le … · mis à jour le … » affichée sous le titre (arbitrage du
 * mainteneur, 23.10.2026).
 */
import { organizationReference } from "../../lib/seo/entities";
import { jsonLd } from "../../lib/utils/json-ld";

interface Props {
	headline: string;
	description: string;
	url: string;
	/** Dates ISO (AAAA-MM-JJ) des <time datetime> affichés. */
	publishedIso: string;
	updatedIso: string;
}

const { headline, description, url, publishedIso, updatedIso } = Astro.props;

const schema = {
	"@context": "https://schema.org",
	"@type": "Article",
	headline,
	description,
	url: new URL(url, Astro.site).href,
	inLanguage: "fr-CH",
	datePublished: publishedIso,
	dateModified: updatedIso,
	author: organizationReference(),
	publisher: organizationReference(),
};
---

<script type="application/ld+json" is:inline set:html={jsonLd(schema)} />
