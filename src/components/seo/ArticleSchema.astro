---
/**
 * ArticleSchema — JSON-LD schema.org/Article d'un guide. Auteur et éditeur :
 * l'éditeur du site, déclaré sur l'accueil, jamais une personne.
 *
 * Rien qui ne se lise sur la page (tests/seo/bing.test.ts) : le titre est le H1,
 * la date de modification celle de « Mis à jour le ». Ni description (la
 * méta-description ne s'affiche pas dans l'article) ni date de publication
 * (non affichée).
 */
import { organizationReference } from "../../lib/seo/entities";
import { jsonLd } from "../../lib/utils/json-ld";

interface Props {
	headline: string;
	url: string;
	updatedOn: Date;
}

const { headline, url, updatedOn } = Astro.props;

const schema = {
	"@context": "https://schema.org",
	"@type": "Article",
	headline,
	url: new URL(url, Astro.site).href,
	inLanguage: "fr-CH",
	dateModified: updatedOn.toISOString().slice(0, 10),
	author: organizationReference(),
	publisher: organizationReference(),
};
---

<script type="application/ld+json" is:inline set:html={jsonLd(schema)} />
