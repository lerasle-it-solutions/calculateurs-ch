---
/**
 * CalculatorShell — assemble une page de calculateur à partir de sa
 * CalculatorDefinition (voir CLAUDE.md § 2).
 *
 * Rend, dans l'ordre du § 4.1 de docs/design-system.md : titre, promesse et
 * ligne de périmètre (héros compact) ; bandeau du cas exemple, formulaire
 * généré depuis les champs et carte résultat ; points de vigilance ; trace
 * (CalculationBreakdown) ; « Ce que ce calcul suppose » (ScopeNotice, fermé) ;
 * variantes ; FAQ ; sources (DataFreshness). Rien n'est supprimé de l'ancienne
 * page : l'introduction et le guide passent dans « Ce que ce calcul suppose ».
 *
 * Le Shell ne fait AUCUN calcul : il pose le squelette et le contrat DOM.
 * Le résultat du cas exemple est rendu au build (`initial`) ; le script de la
 * page, chargé à la première interaction, lit le formulaire à chaque saisie et
 * émet un évènement `calc:update` :
 *
 *   document.dispatchEvent(new CustomEvent("calc:update", {
 *     detail: { value: "<chaîne formatée>", breakdown: [ { label, detail?, amount, note? } ],
 *               status?: { text, short, link? } }
 *   }));
 *
 * ResultCard écoute `detail.value` et `detail.status`, CalculationBreakdown
 * écoute `detail.breakdown`. Un `status` remplace le montant par son message
 * dans la carte, et par sa mention courte, liée à la carte, dans la barre
 * mobile.
 * Rien n'est envoyé nulle part.
 *
 * Mise en page (docs/design-system.md § 2.5) : dès `lg`, deux colonnes, saisie
 * à gauche et carte résultat collante à droite ; en dessous, une barre fixée
 * en bas de l'écran répète le libellé et le montant, avec un lien vers le
 * détail. Elle porte `data-result-card` : les vues du résultat la mettent à
 * jour comme la carte (src/lib/display/result-views.ts). Jamais d'appel commercial dans la barre.
 */
import ScopeNotice from "../ui/ScopeNotice.astro";
import ResultCard from "../ui/ResultCard.astro";
import CalculationBreakdown from "../ui/CalculationBreakdown.astro";
import DataFreshness from "../ui/DataFreshness.astro";
import RelatedVariants from "./RelatedVariants.astro";
import VigilancePoints from "./VigilancePoints.astro";
import Section from "../layout/Section.astro";
import { fr } from "../../i18n/fr";
import type { CalculatorDefinition, FieldDefinition, ProfileGroup } from "../../calculators/types";
import FormField from "./FormField.astro";
import type { FormOutcome } from "../../lib/display/calculator-form";
import { exampleFormValues } from "../../calculators/field-values";

interface Props {
	definition: CalculatorDefinition;
	/**
	 * Introduction, un ou plusieurs paragraphes. FRANÇAIS. Rendue dans « Ce que
	 * ce calcul suppose » ; un paragraphe identique à la promesse n'est pas répété.
	 */
	intro: string | string[];
	/** Libellé de la ResultCard. FRANÇAIS. */
	resultLabel: string;
	/** Réserve affichée sous le résultat (estimation indicative…). FRANÇAIS. */
	resultNote?: string;
	/** Annonce rendue au build dans la ligne de périmètre, au-dessus du formulaire (année de calcul antérieure). FRANÇAIS. */
	notice?: string;
	/** Lien vers le guide qui explique le calculateur, sous l'introduction (« Ce que ce calcul suppose »). */
	guide?: { label: string; url: string };
	/** Date de vérification des barèmes utilisés (couche de données, R2). ISO 8601. */
	verifiedOn: string;
	/**
	 * Catalogue des calculateurs connus, pour résoudre les ids de `variants` et
	 * de `notCovered[].alternative` en liens. Une entrée introuvable est rendue
	 * en texte simple, jamais en lien mort.
	 */
	catalog?: CalculatorDefinition[];
	/**
	 * Chemin « Je pars de mon salaire brut » (§ 4.3) : son contenu est
	 * l'emplacement `gross-path` (GrossEstimator), rendu après les champs du
	 * revenu imposable. `available: false` : l'estimateur n'a pas de données pour
	 * l'année de calcul, le chemin et le lien du bandeau sont désactivés, avec une
	 * phrase (arbitrage du 17.10.2026).
	 */
	grossPath?: { available: boolean; year: number };
	/**
	 * Résultat du cas exemple, calculé au build en exécutant le moteur sur
	 * `definition.example` (docs/design-system.md § 4.2) : affiché au
	 * chargement, sans JavaScript.
	 */
	initial?: Pick<FormOutcome<unknown>, "value" | "breakdown" | "status" | "note" | "maxima">;
	/** Identifiant du bloc des points de vigilance (titre). */
	vigilanceId?: string;
}

const {
	definition,
	intro,
	resultLabel,
	resultNote,
	notice,
	guide,
	verifiedOn,
	catalog = [],
	grossPath,
	initial = { value: fr.common.emptyValue, breakdown: [], status: null, note: null },
	vigilanceId: vigilanceIdProp,
} = Astro.props;

/** Saisie au chargement : celle du cas exemple, sinon la valeur par défaut du champ. */
const filled = exampleFormValues(definition);

// Profils (§ 4.3) : les questions d'un groupe ne s'affichent que pour « Autre situation »
const profileGroups = definition.profiles ?? [];
const groupOf = (field: FieldDefinition) => profileGroups.find((group) => group.fields.includes(field.name));

/** Conditions d'affichage d'un champ : les siennes, et « Autre situation » pour une question de profil. */
const conditionsOf = (field: FieldDefinition): [string, string][] => {
	const group = groupOf(field);
	return [
		...(field.shownWhen ?? []).map((condition): [string, string] => [condition.field, condition.value]),
		...(group ? [[group.name, "other"] as [string, string]] : []),
	];
};
const shown = (conditions: [string, string][]) => conditions.every(([name, value]) => filled[name] === value);
const conditionsAttribute = (conditions: [string, string][]) => (conditions.length > 0 ? JSON.stringify(conditions) : undefined);

/**
 * Formulaire en segments : un champ ; les champs du revenu imposable, regroupés
 * dans le bloc de leur chemin ; ou un groupe de profils, rendu avant sa première
 * question.
 */
type Segment =
	| { kind: "field"; field: FieldDefinition }
	| { kind: "income"; fields: FieldDefinition[] }
	| { kind: "profiles"; group: ProfileGroup };
const segments: Segment[] = [];
for (const field of definition.fields) {
	const group = groupOf(field);
	if (group && group.fields[0] === field.name) segments.push({ kind: "profiles", group });
	const last = segments.at(-1);
	if (field.kind === "number" && field.incomePath) {
		if (last?.kind === "income") last.fields.push(field);
		else segments.push({ kind: "income", fields: [field] });
	} else segments.push({ kind: "field", field });
}
const hasIncomePaths = segments.some((segment) => segment.kind === "income") && grossPath !== undefined;
const grossContent = Astro.slots.has("gross-path") ? await Astro.slots.render("gross-path") : "";
/** Revenu repris d'un autre champ (« différent ? ») : déplié au chargement si l'exemple le distingue. */
const differs = (field: FieldDefinition) =>
	field.kind === "number" && field.sameAs !== undefined && (filled[field.name] ?? "") !== "" && filled[field.name] !== filled[field.sameAs];

/** Pastille d'un bouton radio (§ 2.3) : cible de 48 px, état coché en `accent-tint`. */
const pillBase =
	"flex min-h-3xl cursor-pointer gap-sm border border-rule bg-paper px-lg text-label transition-colors duration-150 hover:border-ink " +
	"has-[:checked]:border-accent has-[:checked]:bg-accent-tint has-[:checked]:text-ink " +
	"has-[:disabled]:cursor-not-allowed has-[:disabled]:border-hairline has-[:disabled]:bg-tint has-[:disabled]:text-ink-muted";
const pill = `${pillBase} items-center rounded-button`;
/** Profil dont le libellé est suivi de la liste de ce qu'il affirme : rayon de contrôle, contenu en haut. */
const pillWithDetails = `${pillBase} items-start rounded-control py-md`;

const byId = new Map(catalog.map((entry) => [entry.id, entry]));

const formId = definition.id.replace(/[^a-z0-9]+/gi, "-");
const fieldId = (name: string) => `${formId}-${name}`;

const notCovered = definition.scope.notCovered.map((entry) => {
	if (typeof entry.alternative === "object") {
		return { case: entry.case, alternative: entry.alternative };
	}
	const alternative = entry.alternative ? byId.get(entry.alternative) : undefined;
	return {
		case: entry.case,
		alternative: alternative
			? { label: alternative.title, url: alternative.slug }
			: undefined,
	};
});

const variants = definition.variants
	.map((id) => byId.get(id))
	.filter((entry): entry is CalculatorDefinition => Boolean(entry))
	.map((entry) => ({ slug: entry.slug, title: entry.title }));

const introParagraphs = (Array.isArray(intro) ? intro : [intro]).filter((paragraph) => paragraph !== "" && paragraph !== definition.promise);
const assumptionsId = "ce-que-ce-calcul-suppose";
/** Identifiant des points de vigilance : celui que la page donne, sinon un identifiant dérivé du formulaire. */
const vigilanceId = vigilanceIdProp ?? `${formId}-vigilance`;

const resultFor = definition.fields
	.map((field) => fieldId(field.name))
	.join(" ");
---

<article class="pb-5xl lg:pb-0">
	<Section compact class="flex flex-col gap-2xl">
	<div class="flex min-w-0 flex-col gap-lg">
	<header class="flex max-w-reading flex-col gap-xs">
		<h1 class="text-title">{definition.title}</h1>
		<p class="text-lead text-ink-muted">{definition.promise}</p>
		<p class="text-fine text-ink-muted">
			{definition.scopeLine}
			{notice && <> {notice}</>}
			{definition.scope.partialCantons && definition.scope.partialCantons.length > 0 && (
				<> {fr.partialCoverage.scopeLine(definition.scope.partialCantons)}</>
			)}
			{" "}<a href={`#${assumptionsId}`} class="font-bold">{fr.calculator.assumptionsLink}</a>
		</p>
	</header>

	<div data-calculator-root class="grid min-w-0 gap-2xl lg:grid-cols-[2fr_3fr]">
		<div class="flex min-w-0 flex-col gap-xl lg:self-start">
		<p data-example-banner class="rounded-panel bg-tint p-lg text-label">
			<strong class="font-bold">{fr.calculator.examplePrefix}</strong> {definition.example.label} {fr.calculator.exampleReplace}
			{hasIncomePaths ? (
				<>
					{" "}<button
						type="button"
						data-switch-gross
						disabled={!grossPath!.available}
						class="cursor-pointer font-bold text-accent underline disabled:cursor-not-allowed disabled:text-ink-muted disabled:no-underline"
					>{fr.incomePath.exampleGrossLink}</button>.
				</>
			) : (
				<>.</>
			)}
		</p>
		<form
			data-calculator
			id={formId}
			class="flex min-w-0 flex-col gap-xl"
			novalidate
			data-invalid-text={fr.numberField.cardStatus}
			data-invalid-short={fr.numberField.cardShort}
		>
			{hasIncomePaths && (
				<fieldset data-income-paths class="flex flex-col gap-sm">
					<legend class="sr-only">{fr.incomePath.legend}</legend>
					<div class="flex flex-wrap gap-sm">
						<label class={pill}>
							<input type="radio" name="incomePath" value="gross" disabled={!grossPath!.available} class="size-icon" />
							{fr.incomePath.gross}
						</label>
						<label class={pill}>
							<input type="radio" name="incomePath" value="taxable" checked class="size-icon" />
							{fr.incomePath.taxable}
						</label>
					</div>
					{!grossPath!.available && <p class="text-fine text-ink-muted">{fr.incomePath.grossUnavailable(grossPath!.year)}</p>}
				</fieldset>
			)}
			{
				segments.map((segment) =>
					segment.kind === "profiles" ? (
						<fieldset
							data-profile-group={segment.group.name}
							data-shown-when={segment.group.shownWhen ? conditionsAttribute([[segment.group.shownWhen.field, segment.group.shownWhen.value]]) : undefined}
							hidden={segment.group.shownWhen ? filled[segment.group.shownWhen.field] !== segment.group.shownWhen.value : false}
							class="flex flex-col gap-sm"
						>
							<legend class="mb-xs text-label font-bold">{segment.group.legend}</legend>
							<div class="flex flex-wrap gap-sm">
								{segment.group.profiles.map((profile) => (
									<label class={profile.details ? pillWithDetails : pill}>
										<input
											type="radio"
											name={segment.group.name}
											value={profile.value}
											checked={filled[segment.group.name] === profile.value}
											data-profile-values={JSON.stringify(profile.values)}
											class="size-icon shrink-0"
										/>
										{profile.details ? (
											<span class="flex flex-col gap-xs">
												<span class="font-bold">{profile.label}</span>
												<ul class="flex list-disc flex-col pl-lg text-fine text-ink-muted">
													{profile.details.map((detail) => <li>{detail}</li>)}
												</ul>
											</span>
										) : (
											profile.label
										)}
									</label>
								))}
								<label class={pill}>
									<input type="radio" name={segment.group.name} value="other" checked={filled[segment.group.name] === "other"} class="size-icon" />
									{segment.group.otherLabel}
								</label>
							</div>
						</fieldset>
					) : segment.kind === "income" ? (
						<>
							<div data-path-block="taxable" class="flex flex-col gap-xl">
								{segment.fields.map((field) =>
									field.kind === "number" && field.sameAs ? (
										<details data-same-as={field.sameAs} open={differs(field)} class="group flex flex-col gap-sm">
											<summary class="flex min-h-3xl cursor-pointer list-none flex-wrap items-center gap-x-sm text-label">
												<span class="group-open:hidden">{fr.incomePath.federalSame}</span>
												<span class="font-bold text-accent underline group-open:hidden">{fr.incomePath.federalDifferent}</span>
												<span class="hidden font-bold text-accent underline group-open:inline">{fr.incomePath.federalSameLink}</span>
											</summary>
											<FormField field={field} id={fieldId(field.name)} values={filled} cantonsCovered={definition.scope.cantonsCovered} />
										</details>
									) : (
										<FormField field={field} id={fieldId(field.name)} values={filled} cantonsCovered={definition.scope.cantonsCovered} />
									),
								)}
							</div>
							{hasIncomePaths && grossContent && (
								<div data-path-block="gross" hidden>
									<Fragment set:html={grossContent} />
								</div>
							)}
						</>
					) : (
						<div
							class="contents"
							data-shown-when={conditionsAttribute(conditionsOf(segment.field))}
							hidden={!shown(conditionsOf(segment.field))}
						>
							<FormField
								field={segment.field}
								id={fieldId(segment.field.name)}
								values={filled}
								cantonsCovered={definition.scope.cantonsCovered}
								maximum={initial.maxima?.[segment.field.name] ?? null}
							/>
						</div>
					),
				)
			}
		</form>
		</div>

		<div class="min-w-0">
			<div class="lg:sticky lg:top-5xl">
				<ResultCard
					id={`${formId}-result`}
					for={resultFor}
					label={resultLabel}
					value={initial.value}
					status={initial.status}
					note={initial.note}
				/>
				{definition.eligibility && definition.eligibility.length > 0 && (
					<section
						data-eligibility
						data-met={fr.form.conditionMet}
						data-not-met={fr.form.conditionNotMet}
						class="mt-md flex max-w-reading flex-col gap-xs rounded-panel border border-hairline bg-paper p-lg text-label"
					>
						<h3 class="font-bold">{fr.form.eligibilityHeading}</h3>
						<ul class="flex flex-col gap-xs">
							{definition.eligibility.map((condition) => (
								<li data-condition={condition.field} data-condition-value={condition.value} class="flex flex-wrap justify-between gap-x-md">
									<span>{condition.label}</span>
									<strong data-condition-state class="font-bold">
										{filled[condition.field] === condition.value ? fr.form.conditionMet : fr.form.conditionNotMet}
									</strong>
								</li>
							))}
						</ul>
					</section>
				)}
				{/* Compléments du résultat propres à un calculateur (parts, rappels), rendus par la page */}
				<slot name="result" />
				{resultNote && <p class="mt-md max-w-reading text-fine text-ink-muted">{resultNote}</p>}
			</div>
		</div>

		{definition.vigilance && definition.vigilance.length > 0 && (
			<div class="min-w-0 lg:col-span-2">
				<VigilancePoints id={vigilanceId} points={definition.vigilance} />
			</div>
		)}

		<div id="detail-du-calcul" class="min-w-0 scroll-mt-5xl lg:col-span-2">
			<CalculationBreakdown open={true} rows={initial.breakdown} />
		</div>
	</div>

	</div>

	<details id={assumptionsId} class="scroll-mt-5xl rounded-panel border border-hairline bg-paper">
		<summary class="flex min-h-3xl cursor-pointer items-center rounded-panel px-xl py-md text-label font-bold hover:bg-tint">
			{fr.calculator.assumptionsSummary}
		</summary>
		<div class="flex flex-col gap-xl border-t border-hairline p-lg md:p-xl">
			<ScopeNotice
				forWhom={definition.scope.forWhom}
				notCovered={notCovered}
				assumptions={definition.scope.assumptions}
				headingLevel={3}
			/>
			{(introParagraphs.length > 0 || guide) && (
				<section class="flex max-w-reading flex-col gap-sm">
					<h3 class="text-label font-bold">{fr.calculator.introHeading}</h3>
					{introParagraphs.map((paragraph) => <p class="text-body">{paragraph}</p>)}
					{guide && (
						<p class="text-label font-bold">
							<a href={guide.url}>{guide.label}</a>
						</p>
					)}
				</section>
			)}
		</div>
	</details>
	</Section>

	<Section tone="tint" class="flex flex-col gap-3xl">
		{variants.length > 0 && <RelatedVariants variants={variants} />}

		{definition.faq.length > 0 && (
			<section class="flex max-w-reading flex-col gap-lg">
				<h2 class="text-heading">{fr.calculator.faqTitle}</h2>
				<div class="border-b border-hairline">
					{definition.faq.map((item) => (
						<details class="border-t border-hairline">
							<summary class="flex min-h-3xl cursor-pointer items-center py-md text-body font-bold">
								{item.question}
							</summary>
							<p class="max-w-reading pb-lg text-body">{item.answer}</p>
						</details>
					))}
				</div>
			</section>
		)}

		<DataFreshness
			referenceYear={definition.scope.referenceYear}
			verifiedOn={verifiedOn}
			sourceIds={definition.sourceIds}
		/>
	</Section>

	<div
		data-result-card
		class="fixed inset-x-0 bottom-0 z-10 bg-paper px-lg py-md shadow-bar md:px-2xl lg:hidden"
	>
		<div class="mx-auto flex max-w-page items-center justify-between gap-md">
			<div class="flex min-w-0 flex-col">
				<span class="text-fine font-bold">{resultLabel}</span>
				<a href="#detail-du-calcul" class="text-fine font-bold">{fr.calculator.seeBreakdown}</a>
			</div>
			<span data-result-value hidden={initial.status !== null} class="text-heading text-accent tabular-nums" aria-hidden="true">{initial.value}</span>
			<a data-result-status hidden={initial.status === null} href={`#${formId}-result`} class="text-label font-bold">{initial.status?.short}</a>
		</div>
	</div>
</article>
