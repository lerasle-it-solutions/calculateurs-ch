---
/**
 * Libellés fixes de la trace, en JSON dans la page, pour le script d'un
 * calculateur qui exécute le moteur dans le navigateur : ceux du moteur, et
 * ceux des modules du calculateur (`modules`). Les modules de libellés du
 * navigateur les lisent par position (src/lib/build/browser-trace-labels.ts) :
 * toute page dont le script importe le moteur inclut ce composant.
 */
import {
	traceLabelsElementId,
	traceLabelValues,
	type TraceLabelModule,
} from "../../lib/build/browser-trace-labels";

interface Props {
	/** Modules de libellés propres au calculateur, en plus de ceux du moteur. */
	modules?: Exclude<TraceLabelModule, "engine">[];
}

const { modules = [] } = Astro.props;

// Sans « < » qui fermerait la balise
const blocks = (["engine", ...modules] as TraceLabelModule[]).map((module) => ({
	id: traceLabelsElementId(module),
	json: JSON.stringify(traceLabelValues(module)).replace(/</g, "\\u003c"),
}));
---

{blocks.map(({ id, json }) => <script type="application/json" id={id} set:html={json} />)}
