---
/**
 * Points de vigilance d'un calculateur (docs/design-system.md § 4.1, bloc 5),
 * toujours affichés sous la carte résultat, même sans résultat. Éléments
 * natifs, aucun JavaScript.
 *
 * Deux styles, une couleur un rôle (arbitrage du 17.10.2026, § 1.1) :
 * avertissement renforcé (`warning`, préfixe « Attention : ») pour ce qui peut
 * faire perdre la déduction ou de l'argent ; avis informatif (`info`) pour le
 * reste.
 */
import { fr } from "../../i18n/fr";
import type { VigilancePoint } from "../../calculators/types";

interface Props {
	id: string;
	points: VigilancePoint[];
}

const { id, points } = Astro.props;
---

<section class="flex max-w-reading flex-col gap-md" aria-labelledby={id}>
	<h2 id={id} class="text-subheading">{fr.calculator.vigilanceHeading}</h2>
	{
		points.map((point) => (
			<aside
				class:list={[
					"flex flex-col gap-xs p-lg text-label",
					point.level === "warning" ? "rounded-r-panel border-l-4 border-warning-signal bg-warning-tint text-ink" : "rounded-panel bg-tint",
				]}
			>
				<p>
					{point.level === "warning" && <strong class="font-bold text-warning">{fr.calculator.warningPrefix} </strong>}
					{point.title && <strong class="font-bold">{point.title} </strong>}
					{point.text}
				</p>
				{point.items && point.items.length > 0 && (
					<ul class="flex list-disc flex-col gap-xs pl-lg">
						{point.items.map((item) => <li>{item}</li>)}
					</ul>
				)}
			</aside>
		))
	}
</section>
