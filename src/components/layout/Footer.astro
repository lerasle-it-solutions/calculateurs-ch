---
/**
 * Footer — logo blanc, familles de calculateurs et liens du site
 * (docs/design-system.md § 2.4) : adresse de contact en clair, dépôt GitHub,
 * date de vérification du site (src/calculators/site-verification.ts),
 * « Signaler une erreur » et ligne d'identité de l'éditeur. Fond encre, texte
 * papier (14,57:1). Aucun JavaScript.
 *
 * « Signaler une erreur » : courriel prérempli avec l'URL canonique de la page,
 * composée au build. Jamais une saisie du calculateur : le fragment d'URL qui
 * les porte n'existe pas au build.
 */
import LogoWhite from "../../assets/brand/logo-blanc.svg";
import { fr } from "../../i18n/fr";
import { PUBLISHED_FAMILIES, familyUrl } from "../../calculators/families";
import { formatVerificationDate, siteVerifiedOn } from "../../calculators/site-verification";

// Seules les familles qui ont leur page sont liées : jamais de lien vers une 404.
const families = PUBLISHED_FAMILIES.map((family) => ({
	label: fr.family[family],
	url: familyUrl(family),
}));

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const report = `mailto:${fr.site.contactEmail}?subject=${encodeURIComponent(fr.footer.reportSubject)}&body=${encodeURIComponent(fr.footer.reportBody(pageUrl))}`;

const links = [
	{ label: fr.footer.methodology, url: "/methodologie/" },
	{ label: fr.footer.data, url: "/donnees/" },
	{ label: fr.footer.legal, url: "/mentions-legales/" },
	{ label: fr.footer.privacy, url: "/politique-de-confidentialite/" },
	{ label: fr.footer.repository, url: fr.site.repositoryUrl },
	// Adresse en clair, texte du lien compris : utilisable sans JavaScript.
	{ label: fr.site.contactEmail, url: `mailto:${fr.site.contactEmail}` },
];
const verifiedOn = siteVerifiedOn();
---

<footer class="bg-ink text-paper">
	<div class="mx-auto grid w-full max-w-page gap-2xl px-lg py-4xl md:grid-cols-3 md:px-2xl">
		<div class="flex flex-col gap-md">
			<a href="/" aria-label={fr.header.homeLabel} class="inline-flex self-start no-underline focus-visible:outline-paper">
				<LogoWhite class="h-xl w-auto max-w-full lg:h-2xl" aria-hidden="true" />
			</a>
			<p class="max-w-reading text-fine">{fr.site.baseline}</p>
			<p class="max-w-reading text-fine">{fr.footer.publisher}</p>
			<p class="text-fine">
				{fr.footer.verified} <time datetime={verifiedOn}>{formatVerificationDate(verifiedOn)}</time>
			</p>
		</div>

		<nav aria-labelledby="footer-calculators" class="flex flex-col gap-md">
			<h2 id="footer-calculators" class="text-label font-bold">{fr.footer.calculatorsHeading}</h2>
			<ul class="flex flex-col gap-sm text-label">
				{
					families.map((family) => (
						<li>
							<a href={family.url} class="text-paper underline hover:text-paper focus-visible:outline-paper">
								{family.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<nav aria-labelledby="footer-site" class="flex flex-col gap-md">
			<h2 id="footer-site" class="text-label font-bold">{fr.footer.siteHeading}</h2>
			<ul class="flex flex-col gap-sm text-label">
				{
					links.map((link) => (
						<li>
							<a href={link.url} class="text-paper underline hover:text-paper focus-visible:outline-paper">
								{link.label}
							</a>
						</li>
					))
				}
				<li>
					<a data-report-error href={report} class="text-paper underline hover:text-paper focus-visible:outline-paper">{fr.footer.reportError}</a>
				</li>
			</ul>
		</nav>
	</div>
</footer>
