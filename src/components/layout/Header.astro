---
/**
 * Header — logotype, trois entrées et pastille de vérification
 * (docs/design-system.md § 2.4, révisé le 17.10.2026). Aucun JavaScript.
 *
 * - Sous `md`, une seule rangée : le logotype et un bouton « Menu » en
 *   <details>/<summary> natif, qui contient les trois entrées et la pastille.
 *   L'en-tête reste à 64 px : le premier champ d'un calculateur est visible à
 *   375 × 667 (§ 4.1).
 * - Dès `md`, les trois entrées et la pastille toujours visibles, sans Menu.
 *
 * Pastille : « Sources vérifiées le JJ.MM.AAAA », liée à /donnees/ — la date de
 * vérification du site, calculée par une seule fonction
 * (src/calculators/site-verification.ts). Jamais « à jour ».
 */
import Logo from "../../assets/brand/logo.svg";
import { fr } from "../../i18n/fr";
import { FAMILY_SEGMENTS } from "../../calculators/families";
import { formatVerificationDate, siteVerifiedOn } from "../../calculators/site-verification";

const path = Astro.url.pathname;
const inGuides = path.includes("/guides/");
const inFamily = Object.values(FAMILY_SEGMENTS).some((segment) => path.startsWith(`/${segment}/`));
const entries = [
	{ label: fr.header.calculators, url: "/#calculateurs", current: inFamily && !inGuides },
	{ label: fr.header.guides, url: "/guides/", current: inGuides || path === "/guides/" },
	{ label: fr.header.methodology, url: "/methodologie/", current: path.startsWith("/methodologie/") },
];
const verifiedOn = siteVerifiedOn();
const current = "aria-[current=page]:text-accent aria-[current=page]:underline";
---

<header class="sticky top-0 z-10 border-b border-hairline bg-paper">
	<div class="relative mx-auto flex min-h-4xl w-full max-w-page items-center justify-between gap-md px-lg md:gap-xl md:px-2xl">
		<a href="/" aria-label={fr.header.homeLabel} class="inline-flex shrink-0 no-underline">
			<Logo class="h-xl w-auto md:h-2xl" aria-hidden="true" />
		</a>

		<nav aria-label={fr.header.navLabel} class="hidden md:ml-auto md:block">
			<ul class="flex items-center gap-xl">
				{
					entries.map((entry) => (
						<li>
							<a
								href={entry.url}
								aria-current={entry.current ? "page" : undefined}
								class={`text-label font-bold text-ink no-underline transition-colors duration-150 hover:text-accent ${current} aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8`}
							>
								{entry.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<a data-verified href="/donnees/" class="hidden min-h-2xl items-center gap-xs rounded-button bg-tint px-sm text-fine font-bold text-ink no-underline hover:underline md:inline-flex">
			{fr.header.verified} <time datetime={verifiedOn}>{formatVerificationDate(verifiedOn)}</time>
		</a>

		<details class="md:hidden">
			<summary class="flex min-h-3xl cursor-pointer list-none items-center gap-sm rounded-button px-sm text-label font-bold text-ink hover:bg-tint [&::-webkit-details-marker]:hidden">
				<svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-icon">
					<path d="M3 5h14M3 10h14M3 15h14"></path>
				</svg>
				{fr.header.menu}
			</summary>
			<div class="absolute inset-x-0 top-full flex flex-col gap-md border-b border-hairline bg-paper px-lg py-xl shadow-raised">
				<nav aria-label={fr.header.navLabel}>
					<ul class="flex flex-col gap-xs">
						{
							entries.map((entry) => (
								<li>
									<a
										href={entry.url}
										aria-current={entry.current ? "page" : undefined}
										class={`flex min-h-3xl items-center rounded-control px-md text-body font-bold text-ink no-underline hover:bg-tint ${current}`}
									>
										{entry.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
				<a data-verified href="/donnees/" class="inline-flex min-h-3xl items-center gap-xs self-start rounded-button bg-tint px-md text-fine font-bold text-ink no-underline hover:underline">
					{fr.header.verified} <time datetime={verifiedOn}>{formatVerificationDate(verifiedOn)}</time>
				</a>
			</div>
		</details>
	</div>
</header>
