---
/**
 * Header — logotype, trois entrées et pastille de vérification
 * (docs/design-system.md § 2.4). Aucun JavaScript, aucun bouton Menu : sous
 * cinq entrées, elles restent visibles à toutes les largeurs ; sous `md`, la
 * navigation passe sur une seconde ligne. Collant, jamais masqué au défilement.
 *
 * Pastille : « Sources vérifiées le JJ.MM.AAAA », liée à /donnees/ — la date de
 * vérification du site, calculée par une seule fonction
 * (src/calculators/site-verification.ts). Jamais « à jour ».
 */
import Logo from "../../assets/brand/logo.svg";
import { fr } from "../../i18n/fr";
import { FAMILY_SEGMENTS } from "../../calculators/families";
import { formatVerificationDate, siteVerifiedOn } from "../../calculators/site-verification";

const path = Astro.url.pathname;
const inGuides = path.includes("/guides/");
const inFamily = Object.values(FAMILY_SEGMENTS).some((segment) => path.startsWith(`/${segment}/`));
const entries = [
	{ label: fr.header.calculators, url: "/#calculateurs", current: inFamily && !inGuides },
	{ label: fr.header.guides, url: "/guides/", current: inGuides || path === "/guides/" },
	{ label: fr.header.methodology, url: "/methodologie/", current: path.startsWith("/methodologie/") },
];
const verifiedOn = siteVerifiedOn();
---

<header class="sticky top-0 z-10 border-b border-hairline bg-paper">
	<div class="mx-auto flex min-h-4xl w-full max-w-page flex-wrap items-center justify-between gap-x-md gap-y-xs px-lg py-sm md:flex-nowrap md:gap-x-xl md:px-2xl md:py-0">
		<a href="/" aria-label={fr.header.homeLabel} class="inline-flex shrink-0 no-underline">
			<Logo class="h-xl w-auto md:h-2xl" aria-hidden="true" />
		</a>

		{/* Sous md, sur deux lignes à côté du logo : l'en-tête garde deux rangées */}
		<a href="/donnees/" class="inline-flex flex-col rounded-control bg-tint px-sm py-2xs text-fine font-bold text-ink no-underline hover:underline md:order-last md:flex-row md:gap-xs md:rounded-button">
			<span>{fr.header.verified}</span>
			<time datetime={verifiedOn}>{formatVerificationDate(verifiedOn)}</time>
		</a>

		<nav aria-label={fr.header.navLabel} class="w-full md:ml-auto md:w-auto">
			<ul class="flex flex-wrap items-center gap-x-xl gap-y-xs">
				{
					entries.map((entry) => (
						<li>
							<a
								href={entry.url}
								aria-current={entry.current ? "page" : undefined}
								class="inline-flex min-h-3xl items-center text-label font-bold text-ink no-underline transition-colors duration-150 hover:text-accent aria-[current=page]:text-accent aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
							>
								{entry.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
