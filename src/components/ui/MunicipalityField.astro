---
/**
 * MunicipalityField — saisie d'une commune avec autocomplétion native.
 * Éléments natifs : <input list> + <datalist>. Aucun JavaScript, aucun îlot.
 *
 * L'attribut `list` relie l'input au datalist ; le navigateur fournit
 * l'autocomplétion et le filtrage sans une ligne de script.
 *
 * `deferred` : la liste est rendue vide, marquée `data-municipality-options` ;
 * le script de la page la remplit à la première interaction, depuis le fichier
 * de données (src/lib/display/tax-data.ts). Elle compterait sinon ~24 000
 * octets dans le HTML de chaque page de calculateur.
 *
 * Sous le champ, la limite de couverture du moteur au moment du choix
 * (docs/design-system.md § 4.3) : masquée au rendu, elle s'affiche quand le
 * script de la page publie un statut de couverture (`calc:update`), avec le
 * lien vers la calculette du canton. Le script de ResultCard l'applique
 * (`coverageOnly`, src/lib/display/result-card.ts) : aucun script ici.
 */
import { fr } from "../../i18n/fr";
import { fieldControl, fieldHint, fieldLabel, fieldRequired } from "./field-styles";

interface Option {
	value: string;
	label?: string;
}

interface Props {
	id: string;
	name: string;
	label: string;
	options: (string | Option)[];
	value?: string;
	hint?: string;
	required?: boolean;
	/** Options remplies par le script de la page, à la première interaction. */
	deferred?: boolean;
}

const {
	id,
	name,
	label,
	options,
	value,
	hint,
	required = false,
	deferred = false,
} = Astro.props;

const listId = `${id}-list`;
const hintId = hint ? `${id}-hint` : undefined;
const coverageId = `${id}-coverage`;
const describedBy = [hintId, coverageId].filter(Boolean).join(" ");
const normalized: Option[] = options.map((option) =>
	typeof option === "string" ? { value: option } : option,
);
---

<div class="flex flex-col gap-xs">
	<label for={id} class={fieldLabel}>
		{label}
		{required && <span aria-hidden="true" class={fieldRequired}> {fr.common.requiredText}</span>}
	</label>
	{
		hint && (
			<p id={hintId} class={fieldHint}>
				{hint}
			</p>
		)
	}

	<input
		type="text"
		id={id}
		name={name}
		list={listId}
		value={value}
		required={required}
		autocomplete="off"
		aria-describedby={describedBy}
		class={fieldControl}
	/>
	<datalist id={listId} data-municipality-options={deferred ? "" : undefined}>
		{
			!deferred && normalized.map((option) => (
				<option value={option.value}>{option.label}</option>
			))
		}
	</datalist>
	<div
		id={coverageId}
		data-coverage-message
		hidden
		aria-live="polite"
		class="flex flex-col gap-xs rounded-r-panel border-l-4 border-warning-signal bg-warning-tint p-md text-fine text-ink"
	>
		<p>
			<strong class="font-bold text-warning">{fr.partialCoverage.fieldPrefix}</strong>
			<span data-coverage-text></span>
		</p>
		<a data-coverage-link hidden class="self-start font-bold"></a>
	</div>
</div>
