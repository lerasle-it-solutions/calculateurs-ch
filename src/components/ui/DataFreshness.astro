---
/**
 * DataFreshness — la fraîcheur des barèmes utilisés.
 * Éléments natifs : <p> + <time datetime>. Aucun JavaScript :
 * la date est formatée au build.
 *
 * Rendu en bloc source (docs/design-system.md § 2.6) : c'est de l'appareil de
 * sources, pas un produit du calcul.
 * Un `verifiedOn` vide veut dire « jamais vérifiée » (R3) : aucune date n'est
 * formatée.
 *
 * Attribution : si l'une des sources du résultat l'exige (`requiresAttribution`),
 * son texte s'affiche sous la date, tel que le registre le porte — jamais
 * recopié ici.
 */
import { attributionTextsFor } from "../../lib/attribution";
import { fr } from "../../i18n/fr";

interface Props {
	referenceYear: number;
	/** Date de vérification humaine, ISO 8601 ; vide si jamais vérifiée. */
	verifiedOn: string;
	/** Sources sur lesquelles s'appuie le résultat, identifiants du registre. */
	sourceIds?: readonly string[];
}

const { referenceYear, verifiedOn, sourceIds = [] } = Astro.props;
const attributions = attributionTextsFor(sourceIds);

const verifiedLabel =
	verifiedOn === ""
		? null
		: new Intl.DateTimeFormat("fr-CH", {
				day: "2-digit",
				month: "2-digit",
				year: "numeric",
			}).format(new Date(verifiedOn));
---

<div class="flex flex-col gap-xs border-l-2 border-hairline pl-md text-fine text-ink-muted">
	<p>
		{fr.dataFreshness.scalesLabel}{" "}
		<time datetime={String(referenceYear)}>{referenceYear}</time>,{" "}
		{
			verifiedLabel === null ? (
				<span class="font-bold text-warning">{fr.dataFreshness.neverVerified}</span>
			) : (
				<>
					{fr.dataFreshness.verifiedLabel}{" "}
					<time datetime={verifiedOn}>{verifiedLabel}</time>
				</>
			)
		}.
	</p>
	{attributions.map((text) => <p>{text}</p>)}
</div>
