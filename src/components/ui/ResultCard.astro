---
/**
 * ResultCard — le résultat du calcul. Élément natif : <output>.
 *
 * Carte résultat (docs/design-system.md § 2.2) : fond `accent-tint`, chiffre
 * en `text-display text-accent`, l'élément le plus grand et le plus contrasté
 * de la page. Le reste de l'interface s'efface devant lui.
 *
 * Aucun script ici : la valeur rendue à la construction (cas exemple) s'affiche
 * sans JavaScript. Le script de la page, chargé à la demande, abonne la carte à
 * l'évènement `calc:update` (`attachResultViews`,
 * src/lib/display/calculator-runtime.ts). Il ne contient aucune formule.
 *
 * Quand le calcul ne rend pas de résultat (hors périmètre, donnée manquante,
 * saisie à corriger), `detail.status` remplace le montant par son message et
 * son lien, dans la carte même : le visiteur le lit là où il attend le chiffre
 * (src/lib/display/result-card.ts).
 */
import { fr } from "../../i18n/fr";

interface Props {
	id: string;
	/** Liste d'ids des champs qui alimentent ce résultat (attribut `for` natif). */
	for: string;
	label: string;
	/** Valeur initiale, affichée avant tout calcul. */
	value?: string;
	caption?: string;
	/** Nom de l'évènement écouté ; son `detail.value` (chaîne déjà formatée) remplace le contenu. */
	event?: string;
}

const {
	id,
	for: forAttr,
	label,
	value = fr.common.emptyValue,
	caption,
	event = "calc:update",
} = Astro.props;
---

<output
	id={id}
	for={forAttr}
	data-result-card
	data-event={event}
	class="flex scroll-mt-5xl flex-col gap-sm rounded-panel bg-accent-tint p-xl md:p-2xl"
>
	<span class="text-label font-bold">{label}</span>
	<span data-result-value class="text-display text-accent tabular-nums">{value}</span>
	<span data-result-note hidden class="text-label font-bold"></span>
	<span data-result-status hidden class="max-w-reading text-body">
		<span data-status-text></span>{" "}<a data-status-link hidden class="font-bold"></a>
	</span>
	{caption && <span class="text-fine text-ink-muted">{caption}</span>}
</output>

