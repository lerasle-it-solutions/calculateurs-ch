---
/**
 * ResultCard — le résultat du calcul. Élément natif : <output>.
 *
 * Carte résultat (docs/design-system.md § 2.2) : fond `accent-tint`, chiffre
 * en `text-display text-accent`, l'élément le plus grand et le plus contrasté
 * de la page. Le reste de l'interface s'efface devant lui.
 *
 * Aucun script ici : la valeur rendue à la construction (cas exemple) s'affiche
 * sans JavaScript. Le script de la page, chargé à la demande, abonne la carte à
 * l'évènement `calc:update` (`attachResultViews`,
 * src/lib/display/calculator-runtime.ts). Il ne contient aucune formule.
 *
 * Quand le calcul ne rend pas de résultat (hors périmètre, donnée manquante,
 * saisie à corriger), `detail.status` remplace le montant par son message et
 * son lien, dans la carte même : le visiteur le lit là où il attend le chiffre
 * (src/lib/display/result-card.ts). Son type (`status.kind`) fixe son rendu
 * (§ 4.4) : neutre pour une donnée manquante, erreur préfixée « Erreur : » pour
 * une saisie invalide, avertissement renforcé préfixé « Attention : » pour un
 * cas hors périmètre ou une condition légale non remplie.
 *
 * Sous le montant (§ 4.4) : la part du montant retenu par le moteur et le coût net de l'année
 * (`summary`, src/lib/display/result-summary.ts), puis, quand une imposition à
 * la sortie s'applique, son rappel en une phrase avec son lien.
 *
 * Lecteurs d'écran : la carte n'est pas une région annoncée (`aria-live="off"`,
 * l'<output> l'est sinon par défaut) ; seul le montant final est annoncé, une
 * fois la saisie arrêtée, par la région `data-result-announce` (result-views.ts).
 *
 * Recalcul : une transition de 200 ms sur la valeur (`animate-result-refresh`,
 * tokens.css), coupée sous `prefers-reduced-motion`, implémentée ici et dans
 * result-views.ts pour tous les calculateurs (§ 3.3, arbitrage du 17.10.2026).
 */
import { fr } from "../../i18n/fr";
import { statusTone, type ResultStatus } from "../../lib/display/result-card";
import { fillSummary, type ResultSummary } from "../../lib/display/result-summary";

interface Props {
	id: string;
	/** Liste d'ids des champs qui alimentent ce résultat (attribut `for` natif). */
	for: string;
	label: string;
	/** Valeur initiale, affichée avant tout calcul. */
	value?: string;
	caption?: string;
	/** Nom de l'évènement écouté ; son `detail.value` (chaîne déjà formatée) remplace le contenu. */
	event?: string;
	/** Message rendu à la place du montant au chargement (cas exemple calculé au build). */
	status?: ResultStatus | null;
	/** Mention sous le montant au chargement. */
	note?: string | null;
	/** Part du versement et coût net au chargement (cas exemple). */
	summary?: ResultSummary | null;
	/** Rappel de l'imposition à la sortie, affiché avec chaque résultat. FRANÇAIS. */
	exitReminder?: { text: string; link: { label: string; url: string } };
}

const {
	id,
	for: forAttr,
	label,
	value = fr.common.emptyValue,
	caption,
	event = "calc:update",
	status = null,
	note = null,
	summary = null,
	exitReminder,
} = Astro.props;
const t = fr.resultSummary;
const tone = status ? statusTone(status.kind) : "neutral";
---

<output
	id={id}
	for={forAttr}
	data-result-card
	data-event={event}
	aria-live="off"
	class="flex scroll-mt-5xl flex-col gap-sm rounded-panel bg-accent-tint p-xl md:p-2xl"
>
	<span class="text-label font-bold">{label}</span>
	<span data-result-value hidden={status !== null} class="text-display text-accent tabular-nums">{value}</span>
	<span data-result-note hidden={!note} class="text-label font-bold">{note}</span>
	<span data-result-summary hidden={!summary} class="flex flex-col gap-xs text-body">
		<span data-summary-line={t.share} data-capped={t.shareCapped} class="font-bold">{summary && fillSummary(summary.capped ? t.shareCapped : t.share, summary)}</span>
		<span data-summary-line={t.netCost} data-capped={t.netCostCapped}>{summary && fillSummary(summary.capped ? t.netCostCapped : t.netCost, summary)}</span>
	</span>
	{
		exitReminder && (
			<span data-exit-reminder hidden={!summary} class="max-w-reading text-label">
				{exitReminder.text} <a href={exitReminder.link.url} class="font-bold">{exitReminder.link.label}</a>
			</span>
		)
	}
	<span
		data-result-status
		data-warning={tone === "warning" ? "" : undefined}
		data-error={tone === "error" ? "" : undefined}
		hidden={status === null}
		class="group max-w-reading text-body data-warning:rounded-r-panel data-warning:border-l-4 data-warning:border-warning-signal data-warning:bg-warning-tint data-warning:p-md data-error:rounded-panel data-error:bg-error-tint data-error:p-md"
	>
		<strong class="hidden font-bold text-warning group-data-[warning]:inline">{fr.calculator.warningPrefix} </strong><strong class="hidden font-bold text-error group-data-[error]:inline">{fr.numberField.errorPrefix} </strong><span data-status-text>{status?.text}</span>{" "}<a data-status-link hidden={!status?.link} href={status?.link?.url} class="font-bold">{status?.link?.label}</a>
	</span>
	{/* Échec du chargement du calcul (first-interaction.ts) : message neutre, la saisie reste */}
	<span data-load-failed hidden class="flex flex-col items-start gap-sm text-body">
		{fr.calculator.loadFailed}
		<button
			type="button"
			data-load-retry
			class="inline-flex min-h-3xl cursor-pointer items-center justify-center rounded-button border border-ink bg-paper px-xl text-label font-bold text-ink transition-colors duration-150 hover:bg-tint"
		>{fr.calculator.loadRetry}</button>
	</span>
	{caption && <span class="text-fine text-ink-muted">{caption}</span>}
</output>

