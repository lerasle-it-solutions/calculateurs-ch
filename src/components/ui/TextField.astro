---
/**
 * TextField — un champ de texte court. Élément natif : <input type="text">.
 * Aucun JavaScript.
 */
import { fr } from "../../i18n/fr";
import { fieldControl, fieldHint, fieldLabel, fieldRequired } from "./field-styles";

interface Props {
	id: string;
	name: string;
	label: string;
	value?: string;
	inputMode?: "text" | "numeric";
	placeholder?: string;
	hint?: string;
	required?: boolean;
}

const { id, name, label, value, inputMode = "text", placeholder, hint, required = false } = Astro.props;

const hintId = hint ? `${id}-hint` : undefined;
---

<div class="flex flex-col gap-xs">
	<label for={id} class={fieldLabel}>
		{label}
		{required && <span aria-hidden="true" class={fieldRequired}> {fr.common.requiredText}</span>}
	</label>
	{
		hint && (
			<p id={hintId} class={fieldHint}>
				{hint}
			</p>
		)
	}

	<input
		type="text"
		id={id}
		name={name}
		value={value}
		inputmode={inputMode}
		placeholder={placeholder}
		required={required}
		autocomplete="off"
		aria-describedby={hintId}
		class:list={[fieldControl, "tabular-nums"]}
	/>
</div>
