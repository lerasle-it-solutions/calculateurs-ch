---
/**
 * TextField — un champ de texte court. Élément natif : <input type="text">.
 * Aucun JavaScript.
 */
import { fr } from "../../i18n/fr";

interface Props {
	id: string;
	name: string;
	label: string;
	value?: string;
	inputMode?: "text" | "numeric";
	placeholder?: string;
	hint?: string;
	required?: boolean;
}

const { id, name, label, value, inputMode = "text", placeholder, hint, required = false } = Astro.props;

const hintId = hint ? `${id}-hint` : undefined;
---

<div class="flex flex-col gap-xs">
	<label for={id} class="text-label">
		{label}
		{required && <span aria-hidden="true">{fr.common.requiredMark}</span>}
	</label>

	<input
		type="text"
		id={id}
		name={name}
		value={value}
		inputmode={inputMode}
		placeholder={placeholder}
		required={required}
		autocomplete="off"
		aria-describedby={hintId}
		class="w-full border border-rule rounded-control bg-paper px-md py-sm text-body tabular-nums"
	/>

	{
		hint && (
			<p id={hintId} class="text-fine">
				{hint}
			</p>
		)
	}
</div>
