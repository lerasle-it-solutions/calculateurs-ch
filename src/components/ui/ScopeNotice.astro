---
/**
 * ScopeNotice — le périmètre déclaré, affiché AVANT la saisie (principe P5).
 * Élément natif : <aside>. Aucun JavaScript.
 *
 * Avis informatif sur fond `tint` (docs/design-system.md § 2.6). `reinforced` :
 * réservé aux avertissements renforcés des calculateurs A4, B3 et C1 — filet
 * gauche `warning-signal`, fond `warning-tint`, titres en `warning` préfixés
 * « Attention : ». Jamais décoratif.
 */
import { fr } from "../../i18n/fr";

interface NotCovered {
	case: string;
	/** Sans `url`, le libellé s'affiche en texte : un conseil, pas un lien. */
	alternative?: { label: string; url?: string };
}

interface Props {
	forWhom: string[];
	notCovered: NotCovered[];
	assumptions?: string[];
	reinforced?: boolean;
	/** Niveau des titres : 3 dans « Ce que ce calcul suppose », sous son propre titre. */
	headingLevel?: 2 | 3;
}

const {
	forWhom,
	notCovered,
	assumptions = [],
	reinforced = false,
	headingLevel = 2,
} = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
---

<aside
	class:list={[
		"flex flex-col gap-lg p-lg text-label",
		reinforced
			? "rounded-r-panel border-l-4 border-warning-signal bg-warning-tint text-ink"
			: "rounded-panel bg-tint",
	]}
>
	<section class="flex flex-col gap-sm">
		<Heading class:list={["font-bold", reinforced && "text-warning"]}>
			{reinforced && fr.scopeNotice.warningPrefix}
			{fr.scopeNotice.forWhom}
		</Heading>
		<ul class="flex max-w-reading list-disc flex-col gap-xs pl-lg">
			{forWhom.map((item) => <li>{item}</li>)}
		</ul>
	</section>

	<section class="flex flex-col gap-sm border-t border-hairline pt-lg">
		<Heading class:list={["font-bold", reinforced && "text-warning"]}>
			{fr.scopeNotice.notCovered}
		</Heading>
		<ul class="flex max-w-reading list-disc flex-col gap-xs pl-lg">
			{
				notCovered.map((item) => (
					<li>
						{item.case}
						{item.alternative && (
							<>
								{" — "}
								{item.alternative.url ? (
									<a href={item.alternative.url}>{item.alternative.label}</a>
								) : (
									item.alternative.label
								)}
							</>
						)}
					</li>
				))
			}
		</ul>
	</section>

	{
		assumptions.length > 0 && (
			<section class="flex flex-col gap-sm border-t border-hairline pt-lg">
				<Heading class:list={["font-bold", reinforced && "text-warning"]}>
					{fr.scopeNotice.assumptions}
				</Heading>
				<ol class="flex max-w-reading list-decimal flex-col gap-xs pl-lg">
					{assumptions.map((item) => (
						<li>{item}</li>
					))}
				</ol>
			</section>
		)
	}
</aside>
