---
/**
 * CalculationBreakdown — la trace du calcul, ligne par ligne (règle R4).
 * Éléments natifs : <details><summary> + <table>. Le repli est celui du
 * navigateur, pas un accordéon maison.
 *
 * Présentation en registre (docs/design-system.md § 2.5 et § 2.7) : libellé à
 * gauche, montant aligné à droite, lignes séparées d'un filet.
 *
 * Aucun script ici : sans JavaScript, il affiche les `rows` fournies au rendu
 * (cas exemple) ou l'état vide. Le script de la page, chargé à la demande,
 * reconstruit les lignes depuis `detail.breakdown` de `calc:update`
 * (`attachResultViews`, src/lib/display/calculator-runtime.ts).
 */
import { fr } from "../../i18n/fr";

interface Row {
	/** Libellé de l'étape. */
	label: string;
	/** Opérande(s) et opération, p. ex. « 12 000 × 13 % ». */
	detail?: string;
	/** Résultat intermédiaire, déjà formaté. */
	amount: string;
	/** Précision affichée à côté du montant, p. ex. « non rachetable ». */
	qualifier?: string;
	/** Hypothèse retenue ou référence de barème, en légende. */
	note?: string;
}

interface Props {
	summary?: string;
	rows?: Row[];
	open?: boolean;
	/** Nom de l'évènement écouté. */
	event?: string;
	/** Texte affiché tant qu'aucune ligne n'est disponible. FRANÇAIS. */
	emptyLabel?: string;
}

const {
	summary = fr.breakdown.summary,
	rows = [],
	open = false,
	event = "calc:update",
	emptyLabel = fr.breakdown.empty,
} = Astro.props;
---

<details
	open={open}
	data-breakdown
	data-event={event}
	data-empty-label={emptyLabel}
	class="rounded-panel border border-hairline bg-paper"
>
	<summary
		class="flex min-h-3xl cursor-pointer items-center rounded-panel px-xl py-md text-label font-bold hover:bg-tint"
	>
		{summary}
	</summary>

	<div class="overflow-x-auto border-t border-hairline">
		<table class="w-full border-collapse text-label [&_tbody_tr:last-child>td]:border-b-0">
			<thead>
				<tr class="bg-tint text-left font-bold">
					<th scope="col" class="border-b border-hairline px-md py-sm">
						{fr.breakdown.stepColumn}
					</th>
					<th scope="col" class="border-b border-hairline px-md py-sm text-right">
						{fr.breakdown.amountColumn}
					</th>
				</tr>
			</thead>
			<tbody data-breakdown-body>
				{
					rows.length === 0 && (
						<tr>
							<td colspan="2" class="px-md py-sm text-fine text-ink-muted">
								{emptyLabel}
							</td>
						</tr>
					)
				}
				{
					rows.map((row) => (
						<tr class="align-top">
							<td class="border-b border-hairline px-md py-sm">
								<span class="block">{row.label}</span>
								{row.detail && (
									<span class="block text-fine text-ink-muted tabular-nums">{row.detail}</span>
								)}
								{row.note && <span class="block text-fine text-ink-muted">{row.note}</span>}
							</td>
							<td class="border-b border-hairline px-md py-sm text-right tabular-nums">
								{row.amount}
								{row.qualifier && <span class="block text-fine">{row.qualifier}</span>}
							</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</details>

