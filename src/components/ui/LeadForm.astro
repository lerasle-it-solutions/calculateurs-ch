---
/**
 * LeadForm — mise en relation avec un partenaire. Élément natif : <form>.
 *
 * JavaScript autorisé ici : validation en ligne et envoi sans rechargement
 * vers la Pages Function `functions/api/lead.ts`. Sans JavaScript, le formulaire
 * reste un POST classique fonctionnel.
 *
 * Règles inscrites dans l'architecture (§ 4) :
 *  - le résultat complet du calcul s'affiche toujours AVANT ce formulaire ;
 *  - facultatif, jamais un mur, jamais une pop-up ;
 *  - consentement explicite, finalité annoncée, un seul partenaire nommé.
 * Champs § 2.3, bouton principal § 2.1, états succès et erreur § 2.6
 * (docs/design-system.md) : le message porte toujours son préfixe en mots
 * (« Envoyé : », « Erreur : »), la couleur ne fait que le doubler.
 */
import Button from "./Button.astro";
import { fr } from "../../i18n/fr";
import { fieldControl, fieldLabel, fieldRequired } from "./field-styles";

interface Props {
	/** Nom du partenaire unique vers qui la demande est transmise. */
	partner: string;
	/** Finalité annoncée du traitement (nLPD). */
	purpose: string;
	action?: string;
}

const { partner, purpose, action = "/api/lead" } = Astro.props;
---

<form
	data-lead-form
	method="post"
	action={action}
	class="flex max-w-reading flex-col gap-xl rounded-panel bg-paper p-xl shadow-card"
>
	<div class="flex flex-col gap-sm">
		<h2 class="text-subheading">{fr.leadForm.heading(partner)}</h2>
		<p class="text-fine text-ink-muted">{purpose}</p>
	</div>

	<div class="flex flex-col gap-xs">
		<label for="lead-name" class={fieldLabel}>
			{fr.leadForm.name}<span aria-hidden="true" class={fieldRequired}> {fr.common.requiredText}</span>
		</label>
		<input type="text" id="lead-name" name="name" required autocomplete="name" class={fieldControl} />
	</div>

	<div class="flex flex-col gap-xs">
		<label for="lead-email" class={fieldLabel}>
			{fr.leadForm.email}<span aria-hidden="true" class={fieldRequired}> {fr.common.requiredText}</span>
		</label>
		<input type="email" id="lead-email" name="email" required autocomplete="email" class={fieldControl} />
	</div>

	<div class="flex flex-col gap-xs">
		<label for="lead-phone" class={fieldLabel}>{fr.leadForm.phone}</label>
		<input
			type="tel"
			id="lead-phone"
			name="phone"
			autocomplete="tel"
			class:list={[fieldControl, "tabular-nums"]}
		/>
	</div>

	<div class="flex items-start gap-sm">
		<input type="checkbox" id="lead-consent" name="consent" required value="yes" class="size-icon shrink-0" />
		<label for="lead-consent" class="text-fine">
			{fr.leadForm.consent(partner)}
		</label>
	</div>

	<Button type="submit" class="self-start" block={true}>{fr.leadForm.submit}</Button>

	<p
		data-lead-status
		role="status"
		aria-live="polite"
		class="rounded-panel p-lg text-label text-ink data-[state=failed]:bg-error-tint data-[state=sent]:bg-success-tint"
		hidden
	>
	</p>
</form>

<script>
	import { fr } from "../../i18n/fr";

	for (const form of document.querySelectorAll<HTMLFormElement>("[data-lead-form]")) {
		const status = form.querySelector<HTMLElement>("[data-lead-status]");

		const say = (message: string, state: "sending" | "sent" | "failed") => {
			if (!status) return;
			status.dataset.state = state;
			status.textContent = message;
			status.hidden = false;
		};

		form.addEventListener("submit", async (event) => {
			if (!form.reportValidity()) return;
			event.preventDefault();

			const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
			if (button) button.disabled = true;
			say(fr.leadForm.sending, "sending");

			try {
				const response = await fetch(form.action, {
					method: "POST",
					headers: { "content-type": "application/json" },
					body: JSON.stringify(Object.fromEntries(new FormData(form))),
				});
				if (!response.ok) throw new Error(String(response.status));
				form.reset();
				say(`${fr.leadForm.sentPrefix}${fr.leadForm.sent}`, "sent");
			} catch {
				say(`${fr.leadForm.failedPrefix}${fr.leadForm.failed}`, "failed");
				if (button) button.disabled = false;
			}
		});
	}
</script>
