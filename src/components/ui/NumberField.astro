---
/**
 * NumberField — un champ numérique. Élément natif : <input type="number">,
 * dans un cadre qui porte bordure, focus et états, avec son unité à droite
 * (docs/design-system.md § 2.3). Aucun JavaScript.
 */
import { fr } from "../../i18n/fr";
import { fieldFrame, fieldFramedInput, fieldHint, fieldLabel, fieldRequired, fieldUnit } from "./field-styles";

interface Props {
	id: string;
	name: string;
	label: string;
	value?: number | string;
	min?: number;
	max?: number;
	step?: number | string;
	unit?: string;
	hint?: string;
	required?: boolean;
}

const {
	id,
	name,
	label,
	value,
	min,
	max,
	step,
	unit,
	hint,
	required = false,
} = Astro.props;

const hintId = hint ? `${id}-hint` : undefined;
---

<div class="flex flex-col gap-xs">
	<label for={id} class={fieldLabel}>
		{label}
		{required && <span aria-hidden="true" class={fieldRequired}> {fr.common.requiredText}</span>}
	</label>
	{
		hint && (
			<p id={hintId} class={fieldHint}>
				{hint}
			</p>
		)
	}

	<div class={fieldFrame}>
		<input
			type="number"
			id={id}
			name={name}
			value={value}
			min={min}
			max={max}
			step={step}
			required={required}
			inputmode="decimal"
			aria-describedby={hintId}
			class={fieldFramedInput}
		/>
		{
			unit && (
				<span class={fieldUnit}>
					{unit}
				</span>
			)
		}
	</div>
</div>
