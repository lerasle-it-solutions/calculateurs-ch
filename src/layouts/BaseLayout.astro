---
import "../styles/tokens.css";

// Polices auto-hébergées via Fontsource — aucune requête vers un domaine tiers.
// IBM Plex Sans : interface et chiffres. IBM Plex Serif : appareil de sources.
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-sans/latin-ext-400.css";
import "@fontsource/ibm-plex-sans/latin-ext-600.css";
import "@fontsource/ibm-plex-serif/latin-400.css";
import "@fontsource/ibm-plex-serif/latin-ext-400.css";

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
	/** Gabarit large, pour les pages de calculateur en deux colonnes. */
	wide?: boolean;
}

const { title, description, noindex = false, wide = false } = Astro.props;
const container = wide ? "max-w-page" : "max-w-reading";
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body class="bg-paper text-ink">
		<main class:list={["mx-auto px-lg py-2xl", container]}>
			<slot />
		</main>
		<footer class:list={["mx-auto border-t border-rule px-lg py-lg", container]}>
			<nav aria-label="Pied de page">
				<ul class="flex flex-wrap gap-lg text-fine">
					<li><a href="/methodologie/">Méthodologie</a></li>
					<li><a href="/donnees/">Données et sources</a></li>
					<li><a href="/protection-des-donnees/">Protection des données</a></li>
					<li><a href="/mentions-legales/">Mentions légales</a></li>
				</ul>
			</nav>
		</footer>
	</body>
</html>
