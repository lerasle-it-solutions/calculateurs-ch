---
import "../styles/tokens.css";

// Police auto-hébergée via Fontsource — aucune requête vers un domaine tiers.
// Une seule famille, Figtree, en deux graisses : 500 (corps, libellés) et 700
// (titres, boutons, résultat). Voir docs/design-system.md § 1.2.
// `500.css` et `700.css` déclarent les sous-ensembles latin et latin-ext avec
// leur unicode-range : latin-ext n'est téléchargé que si un glyphe l'exige.
// Les fichiers par sous-ensemble (`latin-500.css`…) n'ont pas d'unicode-range :
// importés ensemble, ils font télécharger les deux sous-ensembles sur chaque page.
import "@fontsource/figtree/500.css";
import "@fontsource/figtree/700.css";

import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { fr } from "../i18n/fr";

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		{/* Métadonnée de navigateur, pas un style : seule valeur de couleur hors tokens.css. */}
		<meta name="theme-color" content="#1C2A3A" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>
		<meta name="description" content={description} />
		<slot name="head" />
	</head>
	<body class="flex min-h-screen flex-col bg-paper text-ink">
		<a
			href="#main"
			class="sr-only rounded-button bg-paper px-lg py-sm text-label font-bold shadow-raised focus:not-sr-only focus:absolute focus:left-lg focus:top-lg focus:z-20"
		>
			{fr.common.skipToContent}
		</a>

		<Header />

		{/* Pleine largeur : chaque page pose ses sections et leur conteneur (Section, PageHero). */}
		<main id="main" class="flex-1">
			<slot />
		</main>

		<Footer />
	</body>
</html>
