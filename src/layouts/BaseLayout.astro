---
import "../styles/tokens.css";

// Polices auto-hébergées via Fontsource — aucune requête vers un domaine tiers.
// IBM Plex Sans : interface et chiffres. IBM Plex Serif : appareil de sources.
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-sans/latin-ext-400.css";
import "@fontsource/ibm-plex-sans/latin-ext-600.css";
import "@fontsource/ibm-plex-serif/latin-400.css";
import "@fontsource/ibm-plex-serif/latin-ext-400.css";

import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { fr } from "../i18n/fr";

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
	/** Gabarit large, pour les pages de calculateur en deux colonnes. */
	wide?: boolean;
}

const { title, description, noindex = false, wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const container = wide ? "max-w-page" : "max-w-reading";
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>
		<meta name="description" content={description} />
		<slot name="head" />
	</head>
	<body class="bg-paper text-ink">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-lg focus:top-lg focus:z-20 focus:border focus:border-rule focus:bg-paper focus:px-md focus:py-sm focus:text-label"
		>
			{fr.common.skipToContent}
		</a>

		<Header />

		<main id="main" class:list={["mx-auto px-lg py-2xl", container]}>
			<slot />
		</main>

		<Footer />
	</body>
</html>
