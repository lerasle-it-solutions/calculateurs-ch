---
import "../styles/tokens.css";

// Police auto-hébergée via Fontsource — aucune requête vers un domaine tiers.
// Une seule famille, Figtree, en deux graisses : 500 (corps, libellés) et 700
// (titres, boutons, résultat). Le sous-ensemble latin-ext n'est téléchargé que
// si un glyphe l'exige (unicode-range). Voir docs/design-system.md § 1.2.
import "@fontsource/figtree/latin-500.css";
import "@fontsource/figtree/latin-700.css";
import "@fontsource/figtree/latin-ext-500.css";
import "@fontsource/figtree/latin-ext-700.css";

import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { fr } from "../i18n/fr";

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
	/** Gabarit large, pour les pages de calculateur en deux colonnes. */
	wide?: boolean;
}

const { title, description, noindex = false, wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const container = wide ? "max-w-page" : "max-w-reading";
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<!-- Métadonnée de navigateur, pas un style : seule valeur de couleur hors tokens.css. -->
		<meta name="theme-color" content="#1C2A3A" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>
		<meta name="description" content={description} />
		<slot name="head" />
	</head>
	<body class="flex min-h-screen flex-col bg-paper text-ink">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:left-lg focus:top-lg focus:z-20 focus:border focus:border-rule focus:bg-paper focus:px-md focus:py-sm focus:text-label"
		>
			{fr.common.skipToContent}
		</a>

		<Header />

		<main
			id="main"
			class:list={["mx-auto w-full flex-1 px-lg py-2xl", container]}
		>
			<slot />
		</main>

		<Footer />
	</body>
</html>
