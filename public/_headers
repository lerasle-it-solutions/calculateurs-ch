# Cloudflare Pages : en-têtes pour les fichiers statiques.
# Le corps d'une route API (src/pages/**/*.ts) est écrit tel quel au build,
# mais ses en-têtes de réponse ne survivent pas à l'export statique — Cloudflare
# doit les recevoir ici pour les servir sur le fichier généré.

/donnees/coefficients-communaux.csv
  Content-Type: text/csv; charset=utf-8
  Content-Disposition: attachment; filename="coefficients-communaux.csv"

# Fichier de données des calculateurs (src/pages/donnees/calcul/[fichier].ts) :
# nom haché sur le contenu, donc mis en cache sans limite.
/donnees/calcul/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=31536000, immutable
